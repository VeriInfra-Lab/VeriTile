import bench.tritonbench_g.ksoftmax_triton.KsoftmaxTriton
import bench.tritonbench_g.ksoftmax_triton.Proofs.BackwardMath

namespace VeriTile.Bench.TritonBenchG.KsoftmaxTriton.Backward
open VeriTile.Triton
set_option maxHeartbeats 3000000
set_option maxRecDepth 16000

abbrev source := ksoftmax_backward_surface

/-- The existing complete source quotation projects successfully for every
LOG/CAUSAL/IS_FP16 combination. No branch is replaced by a projection stub. -/
theorem source_projects (GradIn GradOut Out : RegionName)
    (bm bn gm gn om on K D : Nat) (log causal fp16 : Bool) :
    (source GradIn GradOut Out bm bn gm gn om on K D log causal fp16).toAlgorithm? =
      .ok (source GradIn GradOut Out bm bn gm gn om on K D log causal fp16).toAlgKernel := by
  cases log <;> cases causal <;> cases fp16 <;> rfl

/-- The final state is generated by reducing the complete source interpreter,
not by constructing a replacement algorithm or assuming a precomputed result.
The checked equation makes this state reusable by totality, readback and frame.
Both reductions are sums, so execution remains total at D=0. -/
noncomputable def source_runState (GradIn GradOut Out : RegionName)
    (bm bn gm gn om on K D : Nat) (log causal fp16 : Bool) (s : BlockState) :
    {t : BlockState //
      exec (source GradIn GradOut Out bm bn gm gn om on K D log causal fp16).toAlgKernel s = some t} := by
  cases log <;> cases causal <;> cases fp16
  all_goals
    refine ⟨?_, ?_⟩
    swap
    dsimp only [source, ksoftmax_backward_surface, ComputeKernel.toAlgKernel,
      ComputeKernel.toAlgorithm?, ComputeStmt.listToAlgorithm?, ComputeStmt.toAlgorithm?,
      ComputeExpr.toAlgorithm?, ComputeOp.toAlgorithm?, Except.bind, Except.pure,
      Bind.bind, Pure.pure]
    simp [exec, stepStmts, stepStmt, evalOp.eq_def, tile_elementwise]
    try rfl

#axiomsClean source_projects
#axiomsClean source_runState
end VeriTile.Bench.TritonBenchG.KsoftmaxTriton.Backward
