def VeriTile.Bench.Repairs.MatrixVectorMultip.Kernels.source : ℕ →
  ℕ → (BLOCK_N BLOCK_M : ℕ) → Random.ArangeSizeDomain BLOCK_N → Random.ArangeSizeDomain BLOCK_M → ComputeKernel :=
fun N M BLOCK_N BLOCK_M rowShape columnShape =>
  have BLOCK_N_1 := Random.i32ArangeSize BLOCK_N rowShape;
  have BLOCK_M_1 := Random.i32ArangeSize BLOCK_M columnShape;
  have A := { name := "A" };
  have B := { name := "B" };
  have C := { name := "C" };
  have stride_an := M;
  have stride_am := 1;
  have stride_bm := 1;
  have stride_cn := 1;
  have dtype := FloatDType.fp32;
  ComputeKernel.mk [A, B] [C]
    [ComputeStmt.assign TileDType.nat [] "N" (ComputeExpr.alg (Op.natToUnsigned 64 (Op.constNat N))),
      ComputeStmt.assign TileDType.nat [] "M" (ComputeExpr.alg (Op.natToUnsigned 64 (Op.constNat M))),
      ComputeStmt.assign TileDType.nat [] "stride_an" (ComputeExpr.alg (Op.natToUnsigned 64 (Op.constNat stride_an))),
      ComputeStmt.assign TileDType.nat [] "stride_am" (ComputeExpr.alg (Op.natToUnsigned 64 (Op.constNat stride_am))),
      ComputeStmt.assign TileDType.nat [] "stride_bm" (ComputeExpr.alg (Op.natToUnsigned 64 (Op.constNat stride_bm))),
      ComputeStmt.assign TileDType.nat [] "stride_cn" (ComputeExpr.alg (Op.natToUnsigned 64 (Op.constNat stride_cn))),
      ComputeStmt.assign TileDType.nat [] "pid" (ComputeExpr.alg (Op.natToUnsigned 64 (Op.programId 0))),
      ComputeStmt.assign TileDType.nat [Random.i32ArangeSize BLOCK_N rowShape, 1] "offset_n"
        (ComputeExpr.alg
          (Op.intToUnsigned 64
            (Op.add NumericDType.int Broadcast.scalarL
              (Op.intToUnsigned 64
                  (Op.mul NumericDType.int Broadcast.nil (Op.ref TileDType.nat [] "pid").castNatToInt
                    (Op.constInt (Int.ofNat (Random.i32ArangeSize BLOCK_N rowShape))))).castNatToInt
              (Op.expandDim ⟨1, ⋯⟩
                  (Op.natToUnsigned 64 (Op.arange (Random.i32ArangeSize BLOCK_N rowShape)))).castNatToInt))),
      ComputeStmt.assign TileDType.nat [1, Random.i32ArangeSize BLOCK_M columnShape] "offset_m"
        (ComputeExpr.alg
          (Op.expandDim ⟨0, ⋯⟩ (Op.natToUnsigned 64 (Op.arange (Random.i32ArangeSize BLOCK_M columnShape))))),
      ComputeStmt.assign TileDType.bool [Random.i32ArangeSize BLOCK_N rowShape, 1] "n_mask"
        (ComputeExpr.alg
          (Op.lt ComparableDType.nat Broadcast.scalarR
            (Op.ref TileDType.nat [Random.i32ArangeSize BLOCK_N rowShape, 1] "offset_n")
            (Op.ref TileDType.nat [] "N"))),
      ComputeStmt.assign TileDType.ptr [Random.i32ArangeSize BLOCK_N rowShape, Random.i32ArangeSize BLOCK_M columnShape]
        "A_ptrs"
        (ComputeExpr.alg
          (Op.ptrAdd Broadcast.scalarL (Op.ptrBase A)
            (Op.add NumericDType.nat Broadcast.nil.consL.consR
              (Op.intToUnsigned 64
                (Op.mul NumericDType.int Broadcast.scalarR
                  (Op.ref TileDType.nat [Random.i32ArangeSize BLOCK_N rowShape, 1] "offset_n").castNatToInt
                  (Op.ref TileDType.nat [] "stride_an").castNatToInt))
              (Op.intToUnsigned 64
                (Op.mul NumericDType.int Broadcast.scalarR
                  (Op.ref TileDType.nat [1, Random.i32ArangeSize BLOCK_M columnShape] "offset_m").castNatToInt
                  (Op.ref TileDType.nat [] "stride_am").castNatToInt))))),
      ComputeStmt.assign TileDType.ptr [1, Random.i32ArangeSize BLOCK_M columnShape] "B_ptrs"
        (ComputeExpr.alg
          (Op.ptrAdd Broadcast.scalarL (Op.ptrBase B)
            (Op.intToUnsigned 64
              (Op.mul NumericDType.int Broadcast.scalarR
                (Op.ref TileDType.nat [1, Random.i32ArangeSize BLOCK_M columnShape] "offset_m").castNatToInt
                (Op.ref TileDType.nat [] "stride_bm").castNatToInt)))),
      ComputeStmt.assign TileDType.real
        [Random.i32ArangeSize BLOCK_N rowShape, Random.i32ArangeSize BLOCK_M columnShape] "acc"
        (ComputeExpr.compute
          (ComputeOp.full [Random.i32ArangeSize BLOCK_N rowShape, Random.i32ArangeSize BLOCK_M columnShape]
            (ComputeOp.alg ComputeDType.fp32 (Op.const 0)))),
      ComputeStmt.assign TileDType.nat [] "m" (ComputeExpr.alg (Op.full [] (Op.natToUnsigned 64 (Op.constNat 0)))),
      ComputeStmt.whileLoop
        (Op.lt ComparableDType.nat Broadcast.nil (Op.ref TileDType.nat [] "m") (Op.ref TileDType.nat [] "M"))
        [ComputeStmt.assign TileDType.bool [1, Random.i32ArangeSize BLOCK_M columnShape] "m_mask"
            (ComputeExpr.alg
              (Op.lt ComparableDType.nat Broadcast.scalarR
                (Op.intToUnsigned 64
                  (Op.add NumericDType.int Broadcast.scalarL (Op.ref TileDType.nat [] "m").castNatToInt
                    (Op.ref TileDType.nat [1, Random.i32ArangeSize BLOCK_M columnShape] "offset_m").castNatToInt))
                (Op.ref TileDType.nat [] "M"))),
          ComputeStmt.assign TileDType.real
            [Random.i32ArangeSize BLOCK_N rowShape, Random.i32ArangeSize BLOCK_M columnShape] "a"
            (ComputeExpr.compute
              (ComputeOp.alg ComputeDType.fp32
                (Op.castFloat dtype FloatDType.real
                  (Op.load dtype.toTileDType
                    (MemAccess.ptr
                      (Op.ref TileDType.ptr
                        [Random.i32ArangeSize BLOCK_N rowShape, Random.i32ArangeSize BLOCK_M columnShape] "A_ptrs"))
                    (MaskOpt.maskOther
                      (Op.boolAnd Broadcast.nil.consL.consR
                        (Op.ref TileDType.bool [Random.i32ArangeSize BLOCK_N rowShape, 1] "n_mask")
                        (Op.ref TileDType.bool [1, Random.i32ArangeSize BLOCK_M columnShape] "m_mask"))
                      ((Op.castFloat FloatDType.real dtype (Op.const 0.0)).broadcast
                        [Random.i32ArangeSize BLOCK_N rowShape, Random.i32ArangeSize BLOCK_M columnShape])))))),
          ComputeStmt.assign TileDType.real [1, Random.i32ArangeSize BLOCK_M columnShape] "b"
            (ComputeExpr.compute
              (ComputeOp.alg ComputeDType.fp32
                (Op.castFloat dtype FloatDType.real
                  (Op.load dtype.toTileDType
                    (MemAccess.ptr (Op.ref TileDType.ptr [1, Random.i32ArangeSize BLOCK_M columnShape] "B_ptrs"))
                    (MaskOpt.maskOther (Op.ref TileDType.bool [1, Random.i32ArangeSize BLOCK_M columnShape] "m_mask")
                      ((Op.castFloat FloatDType.real dtype (Op.const 0.0)).broadcast
                        [1, Random.i32ArangeSize BLOCK_M columnShape])))))),
          ComputeStmt.assign TileDType.real
            [Random.i32ArangeSize BLOCK_N rowShape, Random.i32ArangeSize BLOCK_M columnShape] "acc"
            (ComputeExpr.compute
              (ComputeOp.alg ComputeDType.fp32
                (Op.add NumericDType.real Broadcast.nil.consSame.consSame
                  (Op.ref TileDType.real
                    [Random.i32ArangeSize BLOCK_N rowShape, Random.i32ArangeSize BLOCK_M columnShape] "acc")
                  (Op.mul NumericDType.real Broadcast.nil.consSame.consR
                    (Op.ref TileDType.real
                      [Random.i32ArangeSize BLOCK_N rowShape, Random.i32ArangeSize BLOCK_M columnShape] "a")
                    (Op.ref TileDType.real [1, Random.i32ArangeSize BLOCK_M columnShape] "b"))))),
          ComputeStmt.assign TileDType.ptr
            [Random.i32ArangeSize BLOCK_N rowShape, Random.i32ArangeSize BLOCK_M columnShape] "A_ptrs"
            (ComputeExpr.alg
              (Op.ptrAdd Broadcast.scalarR
                (Op.ref TileDType.ptr [Random.i32ArangeSize BLOCK_N rowShape, Random.i32ArangeSize BLOCK_M columnShape]
                  "A_ptrs")
                (Op.intToUnsigned 64
                  (Op.mul NumericDType.int Broadcast.nil
                    (Op.constInt (Int.ofNat (Random.i32ArangeSize BLOCK_M columnShape)))
                    (Op.ref TileDType.nat [] "stride_am").castNatToInt)))),
          ComputeStmt.assign TileDType.ptr [1, Random.i32ArangeSize BLOCK_M columnShape] "B_ptrs"
            (ComputeExpr.alg
              (Op.ptrAdd Broadcast.scalarR (Op.ref TileDType.ptr [1, Random.i32ArangeSize BLOCK_M columnShape] "B_ptrs")
                (Op.intToUnsigned 64
                  (Op.mul NumericDType.int Broadcast.nil
                    (Op.constInt (Int.ofNat (Random.i32ArangeSize BLOCK_M columnShape)))
                    (Op.ref TileDType.nat [] "stride_bm").castNatToInt)))),
          ComputeStmt.assign TileDType.nat [] "m"
            (ComputeExpr.alg
              (Op.intToUnsigned 64
                (Op.add NumericDType.int Broadcast.nil (Op.ref TileDType.nat [] "m").castNatToInt
                  (Op.constInt (Int.ofNat (Random.i32ArangeSize BLOCK_M columnShape))))))],
      ComputeStmt.assign TileDType.real [Random.i32ArangeSize BLOCK_N rowShape] "acc"
        (ComputeExpr.compute
          (ComputeOp.alg ComputeDType.fp32
            (Op.reduceSum ⟨1, ⋯⟩ «false»
              (Op.ref TileDType.real [Random.i32ArangeSize BLOCK_N rowShape, Random.i32ArangeSize BLOCK_M columnShape]
                "acc")))),
      ComputeStmt.assign TileDType.ptr [Random.i32ArangeSize BLOCK_N rowShape, 1] "C_ptrs"
        (ComputeExpr.alg
          (Op.ptrAdd Broadcast.scalarL (Op.ptrBase C)
            (Op.intToUnsigned 64
              (Op.mul NumericDType.int Broadcast.scalarR
                (Op.ref TileDType.nat [Random.i32ArangeSize BLOCK_N rowShape, 1] "offset_n").castNatToInt
                (Op.ref TileDType.nat [] "stride_cn").castNatToInt)))),
      ComputeStmt.store dtype.toTileDType [Random.i32ArangeSize BLOCK_N rowShape, 1]
        (MemAccess.ptr (Op.ref TileDType.ptr [Random.i32ArangeSize BLOCK_N rowShape, 1] "C_ptrs"))
        (ComputeExpr.alg
          (Op.castFloat FloatDType.real dtype
            (Op.withPrecision FloatDType.real IndexComputePrecision.fp32
              (Op.expandDim ⟨1, ⋯⟩ (Op.ref TileDType.real [Random.i32ArangeSize BLOCK_N rowShape] "acc")))))
        (MaskOpt.mask (Op.ref TileDType.bool [Random.i32ArangeSize BLOCK_N rowShape, 1] "n_mask"))]
