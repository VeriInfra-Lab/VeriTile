VeriTile.Bench.Repairs.TokenAttnReduceVGridYChecked.TensorBridge.kernel_correct (c : TensorCall) (laws : TensorLaws c)
  (metadata : Reader) (read : ℕ → ℝ) (contract : InputContract c.metadata metadata)
  (work : List TokenAttnReduceV.Grid.PID)
  (order : (TokenAttnReduceV.Grid.fullGrid (batches c.metadata) (heads c.metadata)).Perm work) :
  ∃ after,
    TokenAttnReduceV.Grid.run TokenAttnReduceV.Real.algebra TokenAttnReduceV.Real.sum (parameters c.metadata) work
          (view c.metadata read metadata fun a => Triton.FP.Structural.Cell.mk Triton.TileDType.fp32 (read a)) =
        some after ∧
      (∀ b < batches c.metadata,
          ∀ h < heads c.metadata,
            ∀ (d : Fin (width c.metadata)),
              logical (observe id c.metadata read after) c Role.output (outputIndex c.metadata b h ↑d) =
                logicalRealTarget c metadata read b h ↑d) ∧
        RawFrame c.metadata
            (view c.metadata read metadata fun a => Triton.FP.Structural.Cell.mk Triton.TileDType.fp32 (read a)) after ∧
          (∀ (a : ℕ), Exterior c.metadata a → observe id c.metadata read after a = read a) ∧
            (0 < batches c.metadata →
              ∀ r ∈ reads,
                ∀ i < (c r).metadata.numel, logical (observe id c.metadata read after) c r i = logical read c r i)
