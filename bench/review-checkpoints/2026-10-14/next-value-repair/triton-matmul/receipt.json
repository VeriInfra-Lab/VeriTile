  "native_obligations": [
    {
      "id": "DTYPE_ABI_AND_LAUNCH",
      "binding": "Bind same-type A/B/C to either fp16 or float8_e4m3fn, actual dimensions/strides/extents, grouped launch/hints and original numKBlocks/cdiv convention. Local Python runtime test covers fp16 only; no GPU test run here."
    },
    {
      "id": "DOTACC_REDUCTION_AND_FUSION",
      "binding": "Bind each compiler/architecture/BM/BN/BK/numWarps profile to typed half/f8e4 input, fp32 live-accumulator dotAcc. Ascending software FMA is an explicit profile, not an established tensor-core instruction schedule. Do not replace source dotAcc by dot-plus-add."
    },
    {
      "id": "HALF_CAST_PROFILE",
      "binding": "Match binary16 final narrowing, other-zero conversion, signed zero, subnormal/overflow and NaN policy to actual lowering. No whole-domain rounding identity."
    },
    {
      "id": "E4M3_CAST_PROFILE",
      "binding": "Match finite-only e4m3fn encoding, RN-even rounding, finite saturation, canonical NaN and signed-zero choices to the exact Triton/PTX conversion. CUDA/CUTLASS format references alone do not establish this binding."
    },
    {
      "id": "FP32_FMA_CONFIG",
      "binding": "Match rounding, FTZ/DAZ, special values, NaN payload behavior and operand accumulation order for all K blocks. ScalarOps ieeeValue FMA is the named software interpretation."
    },
    {
      "id": "MASKS_AND_OPTIMIZER_HINTS",
      "binding": "Preserve clamped row/column indices, all source K lanes including padding arithmetic, original other=0.0, masked output writes and tl.max_contiguous/tl.multiple_of hint preconditions. No live-only algebraic sum substitution."
    }
  ],
