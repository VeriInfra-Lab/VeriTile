  "scope": {
    "common": "Supplied Prob and gather metadata; all dynamic loop iterations and tails; all BLOCK_DMODEL outputs unmasked; initial +0; all BLOCK_N products, exact source casts, full reduction, cross-block add, final cast/store and frame.",
    "io_domain": "Original spbs=srts=1, BN>0 and count<=T*BN retained; arbitrary T, count, dimensions and original output offset injectivity. General execution/value theorem is stronger: uses exact source address formulas for arbitrary strides.",
    "reduceV": "count=B_Seqlen; identical P and V masks; arbitrary S, including S=0. No pad deletion, no real finite sum.",
    "mistral": "count=B_Att_Seqlen; windowStart=max(B_Seqlen-window,0); P mask start+n<count; V/gather mask start+n+windowStart<sequenceLength. No attSeq=min(seq,window) or finite-V assumption.",
    "memory": "New FP contract uses initial typed cells and proves successful Structural execution plus every output value and frame. Original IO safety/bounds declarations remain byte-for-byte unchanged; no new typed StreamMetaGather skin implementation is claimed.",
    "dtype": "Concrete contract profile is fp32 Prob/V/Out, matching local Python. DTYPE transcription is instantiated at .fp32; this delivery does not claim other storage dtypes.",
    "source_bridge": "Complete original typed-erasure/control correspondence is separately proved; erasure is not claimed value preserving."
  },
  "numerical_model": {
    "parameterized": "Arbitrary opaque value type alpha, Algebra callbacks and a total typed full-tile SumPrimitive; no numerical algebraic laws or assumed final values.",
    "software": "FP.Value.fp32 + ScalarOps per operation, arbitrary Config; ascending lane fold with +0 seed, full BN input, separate rounded multiplication and addition; all output values independent of unused rest callbacks.",
    "used_callbacks": [
      "literal(some fp32, real, +0)",
      "literal(none, real, 0.0)",
      "cast(none, real, fp32): padded zero and final output",
      "binary(some fp32, fp32, mul)",
      "SumPrimitive.apply(some fp32, shape=[BN,BD], axis=0, keepDims=false)",
      "cast(some fp32, fp32, real): explicit erased fp32 carrier",
      "binary(some fp32, real, add): carry update"
    ],
    "extra_numeric_laws": []
  },
