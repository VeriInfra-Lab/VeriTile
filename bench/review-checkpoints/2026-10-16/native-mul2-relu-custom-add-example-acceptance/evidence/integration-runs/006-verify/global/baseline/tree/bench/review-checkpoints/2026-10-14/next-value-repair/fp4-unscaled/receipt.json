      "file": "bench/tritonbench_g/fp4_to_bf16/FPCorrect.lean",
      "name": "VeriTile.Bench.TritonBenchG.Fp4ToBf16.FPCorrect.fp4_to_bf16_unscaled_machine_correctness",
      "kind": "parameterized_complete_software_bit_value_contract",
      "role": "parametric_value_contract",
      "statement": "specification fp4_to_bf16_unscaled_machine_correctness\n    (rest : Algebra Word) (p : Parameters) (initial : State Word)\n    (hbytes : ActiveBytes p initial) :\n    \u2203 final, FP.Structural.exec (backend rest) (source p) initial = some final \u2227\n      final.mem = (written p initial).mem \u2227\n      (\u2200 j : TileIndex [p.block*2], active p initial j \u2192\n        final.mem p.output (outputOffset p initial j) = .mk .bf16 (expectedValue p initial j)) \u2227\n      (\u2200 r o, (r \u2260 p.output \u2228 \u2200 j : TileIndex [p.block*2],\n        active p initial j \u2192 o \u2260 outputOffset p initial j) \u2192 final.mem r o = initial.mem r o)",
      "statement_sha256": "64f1a5d43f6f967228e5a15128ff195a58b03b261e7fdf03d85d86ded75064bd"
    }
  ],
  "scope": "Entire unscaled e2m1 helper+kernel, all packed uint8 inputs, arbitrary count/block/program id and tails; wrapper BLOCK512 included. No scaled-kernel claim.",
