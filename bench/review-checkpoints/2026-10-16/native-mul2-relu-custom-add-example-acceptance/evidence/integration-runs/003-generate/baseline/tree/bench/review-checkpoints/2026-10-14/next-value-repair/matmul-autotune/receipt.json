  "native_obligations": [
    {
      "id": "ABI_DTYPE_AND_AUTOTUNE",
      "binding": "Bind A/B floating storage and fixed fp16 C, exact dimensions/strides/extents, chosen CUDA/HIP tile config, compiler version, numWarps/numStages/wavesPerEu and actual launch/grid. Autotuner correctness not established."
    },
    {
      "id": "DOTACC_PROFILE",
      "binding": "Bind default DotOptions and dtype-dependent compiler default input precision (including possible TF32 on fp32 inputs), tensor-core reduction schedule/fusion and live fp32 carry. The software ascending full-FMA schedule is explicit, not a hardware equality claim."
    },
    {
      "id": "ACTIVATION_PROFILE",
      "binding": "Match source >= ordered comparison, fp32 decimal literal lowering, multiplication rounding, signed zero and NaN behavior; explicit task-local expansion keeps actual fp32 context."
    },
    {
      "id": "CONVERSIONS_AND_SPECIALS",
      "binding": "Match half output and masked other=0.0 conversions, FTZ/DAZ, rounding, overflow/subnormals/NaN canonicalization. No full-domain cast identity."
    },
    {
      "id": "SOURCE_LAYOUT_AND_TRIPS",
      "binding": "Bind supplied numKBlocks to actual cdiv(K,BK), legal tile sizes, grouped scheduler and modulo row/column indices; preserve every padding operation and output mask."
    }
  ],
