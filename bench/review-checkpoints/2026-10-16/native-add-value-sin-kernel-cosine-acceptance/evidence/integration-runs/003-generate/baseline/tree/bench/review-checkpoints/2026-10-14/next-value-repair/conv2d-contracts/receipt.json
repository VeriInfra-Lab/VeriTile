    {
      "id": "DTYPE_AND_LAUNCH",
      "binding": "Pin fp32 Input/Weight/Output storage and fp16=true, original runtime strides/groups/padding/extents, launch grid and active output layout. Preserve both tf32 values in each claimed configuration."
    },
    {
      "id": "HALF_CONVERSION",
      "binding": "Bind native fp32-to-binary16 rounding, NaN canonicalization/payload, signed zero, subnormal/overflow and FTZ behavior to the concrete software conversion. No global half=id law."
    },
    {
      "id": "DOT_SCHEDULE",
      "binding": "Bind every accepted BIN/tile/numWarps/compiler/architecture profile to half-input fp32-output dot. The explicit software schedule is separately rounded multiplies and ascending-lane adds; native tensor-core reduction/accumulation order is not inferred."
    },
    {
      "id": "SOURCE_VS_FUSED_GRAPH",
      "binding": "Source is separate dot result plus fp32 carry add. A compiled fused dotAcc graph needs its own exact primitive/refinement; do not assume associativity, distributivity or equivalence of fused/unfused arithmetic."
    },
    {
      "id": "FP32_ADD_STORE",
      "binding": "Bind fp32 carry add/store and source +0 seed, rounding/FTZ/NaN/signed-zero policy. Store is fp32, not a half output."
    },
    {
      "id": "UNSPECIFIED_MASKED_LOADS",
      "binding": "Both native loads omit other. Bind actual undef/poison behavior and address interpretation; no observed sample of zeros establishes a universal zero-padding guarantee. The checkable 0/2 result difference makes this boundary substantive."
    }
  ],
