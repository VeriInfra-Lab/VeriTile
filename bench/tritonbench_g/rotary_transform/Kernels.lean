def tensorSignature (wideCu wideOffset : Bool) : CallSignature where
  pointers := [("OUT",.fp32),("X",.fp32),("COS",.fp32),("SIN",.fp32),("CU_SEQLENS",match wideCu with | .false => .i32 | .true => .i64),("SEQLEN_OFFSETS",match wideOffset with | .false => .i32 | .true => .i64)]
  scalars := [("seqlen",.integer),("nheads",.integer),("rotary_dim",.integer),("seqlen_ro",.integer),("CACHE_KEY_SEQLEN",.integer),("stride_out_batch",.integer),("stride_out_seqlen",.integer),("stride_out_nheads",.integer),("stride_out_headdim",.integer),("stride_x_batch",.integer),("stride_x_seqlen",.integer),("stride_x_nheads",.integer),("stride_x_headdim",.integer)]
  constexpr := ["BLOCK_K","IS_SEQLEN_OFFSETS_TENSOR","IS_VARLEN","INTERLEAVED","CONJUGATE","BLOCK_M"]

