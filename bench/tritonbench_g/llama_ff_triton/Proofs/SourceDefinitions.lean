def productionSHA256 : String := "60818133d090b5e302bbbcd9554b53ff2113fc214a221071e73d4adcfcef22ea"
def selectedPlans : Nat → Nat → Nat → Nat → DotPlan := fun _ _ _ _ => orderedK16
def selectedReductions : Nat → Nat → Reduction := fun _ _ => butterfly64

/-- Source/compiler/runtime boundary, entirely structural. The scalar and
fixed-instruction machine semantics live in LocalEventABI and NumericLeaves.
AST identity and lowered event graph identity cannot assert an output value. -/
structure CompilerBinding (F H : Type) (s : Shape) (p : Parameters F) (b : Buffers) where
  ast : String
  sourceIdentity : ast=productionAST
  schedule : Schedule s
  physicalLanes : List (Lane s)
  dispatched : physicalLanes.map Lane.cell=schedule.events
  program : Code F H Unit
  lowered : program=gridCode p b selectedPlans selectedReductions schedule.events

def boundExecute (actual : StorageOps F H) (abi : LocalEventABI F H σ actual)
    (binding : CompilerBinding F H s p b) (state : σ) := binding.program.native abi state

abbrev shouldLaunch (s : Shape) : Prop := 0<s.M
def hostCode (s : Shape) (binding : CompilerBinding F H s p b) : Code F H Unit :=
  if shouldLaunch s then binding.program else pure ()

end
end VeriTile.Bench.Repairs.LlamaFF
