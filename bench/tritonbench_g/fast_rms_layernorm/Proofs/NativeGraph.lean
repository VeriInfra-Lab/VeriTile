def productionSHA256 : String := "032d4fa4043306a5b4ad0162e312a74328eaa81e8bdb9f711b5c0cff79d5d75a"

/-- Structural compiler boundary over primitive expressions, never a numerical
whole-output or whole-reduction equation. The selected graph is inspectable. -/
structure CompilerBinding (R : Reductions) (S : Selection) where
  sourceAST : String
  sourceIdentity : sourceAST=productionAST
  compilerReductions : Reductions
  reductionIdentity : compilerReductions=R
  program : Term → Expr
  lowered : ∀ term,program term=lower S term

theorem compiled_expression (binding : CompilerBinding R S) (I : Instructions) (term : Term) :
    (binding.program term).eval I=eval I S term := by rw [binding.lowered];rfl

def compiledEncode (binding : CompilerBinding R S) (I : Instructions) (c : Cell Term) (byte : Fin 4) : Fin 256 :=
  ⟨(((binding.program (c.read .real)).eval I).toNat/2^(8*byte.val))%256,Nat.mod_lt _ (by decide)⟩
theorem compiled_encode (binding : CompilerBinding R S) (I : Instructions) (c : Cell Term) (byte : Fin 4) :
    compiledEncode binding I c byte=encode I S c byte := by
  simp only [compiledEncode,encode,observe,compiled_expression]

