import bench.tritonbench_g.rmsnorm_fused_llama.Proofs.Native
import bench.tritonbench_g.fast_rms_layernorm.Proofs.FPSequence

namespace VeriTile.Bench.Repairs.FastRmsLayernorm.NativeGraph
open VeriTile Triton FP.Structural
noncomputable section
set_option maxHeartbeats 6000000
set_option maxRecDepth 30000
namespace Topology
abbrev Shape := VeriTile.Bench.Repairs.RmsnormFusedLlama.Native.Shape
abbrev Tree := VeriTile.Bench.Repairs.RmsnormFusedLlama.Native.Tree
abbrev Plan := VeriTile.Bench.Repairs.RmsnormFusedLlama.Native.Plan
abbrev Reductions := VeriTile.Bench.Repairs.RmsnormFusedLlama.Native.Reductions
abbrev Fusion := VeriTile.Bench.Repairs.RmsnormFusedLlama.Native.Fusion
abbrev Schedule := VeriTile.Bench.Repairs.RmsnormFusedLlama.Native.Schedule
end Topology
abbrev Word := BitVec 32
inductive Stage | forward | input | weight deriving DecidableEq, Inhabited

/-- Each source operation retains its launch stage. In particular, saved r
expressions retain forward-stage choices when a later launch reads them. -/
inductive Term where
  | leaf (region : RegionName) (address : Nat) (word : Word)
  | literal (precision : Option ComputeDType) (dtype : FloatDType) (value : ℝ)
  | negInf
  | binary (stage : Stage) (precision : Option ComputeDType) (dtype : FloatDType) (op : Binary) (a b : Term)
  | unary (stage : Stage) (precision : Option ComputeDType) (op : Unary) (a : Term)
  | cast (stage : Stage) (precision : Option ComputeDType) (src dst : FloatDType) (a : Term)
  | fromNat (precision : Option ComputeDType) (n : Nat)
  | fromInt (precision : Option ComputeDType) (n : Int)
  | bits (word : Word)
  | epsilon (word : Word)
  | load (a : Term)
  deriving Inhabited

def shape : Term → Topology.Shape
  | .leaf r o _ => .leaf r o
  | .literal p d _ => .literal p d
  | .negInf => .negInf
  | .binary _ p d op a b => .binary p d op (shape a) (shape b)
  | .unary _ p op a => .unary p op (shape a)
  | .cast _ p src dst a => .cast p src dst (shape a)
  | .fromNat p n => .fromNat p n
  | .fromInt p n => .fromInt p n
  | .bits _ => .bits 0
  | .epsilon _ => .leaf "$epsilon" 0
  | .load a => .load (shape a)

/-- Replace only runtime payloads, leaving source operations and metadata fixed. -/
def mapWords (f : Word → Word) : Term → Term
  | .leaf r o w => .leaf r o (f w)
  | .literal p d x => .literal p d x
  | .negInf => .negInf
  | .binary stage p d op a b => .binary stage p d op (mapWords f a) (mapWords f b)
  | .unary stage p op a => .unary stage p op (mapWords f a)
  | .cast stage p src dst a => .cast stage p src dst (mapWords f a)
  | .fromNat p n => .fromNat p n
  | .fromInt p n => .fromInt p n
  | .bits w => .bits (f w)
  | .epsilon w => .epsilon (f w)
  | .load a => .load (mapWords f a)

/-- Every compiler callback sees the same structure after arbitrary changes to
runtime tensor/scalar words, including changes of zero sign or NaN payload. -/
theorem mapWords_shape (f : Word → Word) (t : Term) : shape (mapWords f t)=shape t := by
  induction t <;> simp_all [mapWords,shape]

def expand (stage : Stage) (p : Option ComputeDType) (op : Binary)
    (xs : Fin n → Term) (neutral : Term) : Topology.Tree n → Term
  | .lane i => xs i
  | .neutral => neutral
  | .join a b => .binary stage p .real op (expand stage p op xs neutral a) (expand stage p op xs neutral b)
abbrev Reductions := Stage → Topology.Reductions

def inputs (s : TileShape) (ax : Fin s.length) (keep : Bool) (xs : Values Term .real s) :
    TileIndex (TileShape.reduceShape s ax keep) → Fin (TileShape.axisDim s ax) → Term :=
  match keep with
  | Bool.false => fun out k => xs (TileShape.insertAxisIndex s ax out k)
  | Bool.true => fun out k => xs (TileShape.replaceAxisIndex s ax out k)

def reduction (R : Reductions) (stage : Stage) (isMax : Bool) (p : Option ComputeDType) {s : TileShape}
    (ax : Fin s.length) (keep : Bool) (xs : Values Term .real s)
    (out : TileIndex (TileShape.reduceShape s ax keep)) : Term :=
  let leaves:=inputs s ax keep xs out
  let plan:=R stage isMax p s ax keep out (fun i => shape (leaves i))
  expand stage p (if isMax then .max else .add) leaves
    (if isMax then .negInf else .literal p .real 0) plan.tree

def algebra (R : Reductions) (stage : Stage) : Algebra Term where
  literal := .literal
  negInf := .negInf
  binary := .binary stage
  unary := .unary stage
  cast := .cast stage
  fromNat := .fromNat
  fromInt := .fromInt
  fp32Bits := fun w => .bits w.bits
  fp32Load := .load
  reduceMax := fun p => reduction R stage Bool.true p
  reduceSum := fun p => reduction R stage Bool.false p

/-- A selected source reduction is a finite add tree containing each lane
exactly once and a stated number of neutral leaves. No numerical callback. -/
theorem reduction_lane_coverage (plan : Topology.Plan n) (i : Fin n) :
    some i∈plan.tree.leaves :=
  VeriTile.Bench.Repairs.RmsnormFusedLlama.Native.Plan.lane_coverage plan i

theorem reduction_complete (plan : Topology.Plan n) :
    plan.tree.leaves.Perm ((List.finRange n).map some++List.replicate plan.padding none) := plan.valid

/-- Primitive expression emitted by the structural compiler selection. -/
inductive Expr where
  | word (value : Word)
  | literal (precision : Option ComputeDType) (dtype : FloatDType) (value : ℝ)
  | binary (precision : Option ComputeDType) (dtype : FloatDType) (op : Binary) (a b : Expr)
  | unary (precision : Option ComputeDType) (op : Unary) (a : Expr)
  | cast (precision : Option ComputeDType) (src dst : FloatDType) (a : Expr)
  | fromNat (precision : Option ComputeDType) (n : Nat)
  | fromInt (precision : Option ComputeDType) (n : Int)
  | fma (a b c : Expr)
  | neg (a : Expr)

structure Instructions extends VeriTile.Bench.Repairs.RmsnormFusedLlama.Native.Instructions where
  negate : Word → Word

def Expr.eval (I : Instructions) : Expr → Word
  | .word w => w
  | .literal p d x => I.literal p d x
  | .binary p d op a b => I.binary p d op (a.eval I) (b.eval I)
  | .unary p op a => I.unary p op (a.eval I)
  | .cast p src dst a => I.cast p src dst (a.eval I)
  | .fromNat p n => I.fromNat p n
  | .fromInt p n => I.fromInt p n
  | .fma a b c => I.fmaRN (a.eval I) (b.eval I) (c.eval I)
  | .neg a => I.negate (a.eval I)

structure Selection where
  schedule : Stage → Topology.Schedule
  /-- Which multiplicand is negated in a contracted A-B*C. -/
  negateRight : Stage → Topology.Shape → Bool

def fusion (S : Selection) (stage : Stage) (s : Topology.Shape) : Topology.Fusion :=
  if stage=.weight then .split else (S.schedule stage).fusion s

def binary (S : Selection) (stage : Stage) (p : Option ComputeDType) (d : FloatDType)
    (op : Binary) (a b : Term) (x y : Expr) : Expr :=
  if (S.schedule stage).swap (.binary p d op (shape a) (shape b)) &&
      (op==.add || op==.mul || op==.max) then .binary p d op y x else .binary p d op x y

def fused (S : Selection) (stage : Stage) (a b : Term) (x y z : Expr) : Expr :=
  if (S.schedule stage).swap (.binary (some .fp32) .real .mul (shape a) (shape b)) then .fma y x z else .fma x y z

/-- Adjacent mul/add/sub nodes can contract only at the selected native FP32
sites. Operand order and negation position are explicit; casts block fusion.
The dW stage always retains separate multiplication and addition. -/
def lower (S : Selection) : Term → Expr
  | .leaf _ _ w => .word w
  | .literal p d x => .literal p d x
  | .negInf => .word 0xff800000
  | .binary stage p d .add a b =>
    match fusion S stage (.binary p d .add (shape a) (shape b)),p,d,a,b with
    | .left,some .fp32,.real,.binary _ (some .fp32) .real .mul x y,c =>
      fused S stage x y (lower S x) (lower S y) (lower S c)
    | .right,some .fp32,.real,c,.binary _ (some .fp32) .real .mul x y =>
      fused S stage x y (lower S x) (lower S y) (lower S c)
    | _,_,_,a,b => binary S stage p d .add a b (lower S a) (lower S b)
  | .binary stage p d .sub a b =>
    match fusion S stage (.binary p d .sub (shape a) (shape b)),p,d,a,b with
    | .left,some .fp32,.real,.binary _ (some .fp32) .real .mul x y,c =>
      fused S stage x y (lower S x) (lower S y) (.neg (lower S c))
    | .right,some .fp32,.real,c,.binary _ (some .fp32) .real .mul x y =>
      if S.negateRight stage (.binary p d .sub (shape a) (shape b)) then
        fused S stage x y (lower S x) (.neg (lower S y)) (lower S c)
      else fused S stage x y (.neg (lower S x)) (lower S y) (lower S c)
    | _,_,_,a,b => binary S stage p d .sub a b (lower S a) (lower S b)
  | .binary stage p d op a b => binary S stage p d op a b (lower S a) (lower S b)
  | .unary _ p op a => .unary p op (lower S a)
  | .cast _ p src dst a => .cast p src dst (lower S a)
  | .fromNat p n => .fromNat p n
  | .fromInt p n => .fromInt p n
  | .bits w => .word w
  | .epsilon w => .word w
  | .load a => lower S a

def eval (I : Instructions) (S : Selection) (t : Term) : Word := (lower S t).eval I

def observe (I : Instructions) (S : Selection) (c : Cell Term) := eval I S (c.read .real)
def encode (I : Instructions) (S : Selection) (c : Cell Term) (byte : Fin 4) : Fin 256 :=
  ⟨((observe I S c).toNat/2^(8*byte.val))%256,Nat.mod_lt _ (by decide)⟩

theorem weight_fusion_disabled (S : Selection) (s : Topology.Shape) : fusion S .weight s=.split := by simp [fusion]
theorem leaf_shape (r : RegionName) (o : Nat) (u v : Word) : shape (.leaf r o u)=shape (.leaf r o v) := rfl
/-- Decoded tensor words and runtime scalar words never reach compiler choices. -/
theorem bits_shape (u v : Word) : shape (.bits u)=shape (.bits v) := rfl
theorem epsilon_shape (u v : Word) : shape (.epsilon u)=shape (.epsilon v) := rfl
theorem bits_eval (I : Instructions) (S : Selection) (w : Word) : eval I S (.bits w)=w := rfl
theorem epsilon_eval (I : Instructions) (S : Selection) (w : Word) : eval I S (.epsilon w)=w := rfl

theorem literal_shape (p : Option ComputeDType) (d : FloatDType) (u v : ℝ) :
    shape (.literal p d u)=shape (.literal p d v) := rfl

