import Mathlib.Tactic
import Mathlib.Algebra.Order.Floor.Div
import VeriTile.Meta.StatementAudit

/-! Source launch/index arithmetic, independent of the frontend and AST.
All four output tiles, including their masked-off lanes, must have faithful
signed i32 address arithmetic. The random counter add has different semantics:
it deliberately wraps in uint32 and is specified separately in ScalarSpec.
-/
namespace VeriTile.Bench.TritonBenchG.UniformSampling.SourceDomain

def LegalBlock (B : Nat) : Prop := ∃ k : Nat, k ≤ 20 ∧ B = 2^k

def wrapperBlock (N : Nat) : Nat := if N ≤ 512 then 512 else 1024

def grid (N B : Nat) : Nat := (N + 4*B - 1) / (4*B)

def counterIndex (pid B lane : Nat) : Nat := pid*B + lane

def outputIndex (pid B : Nat) (field : Fin 4) (lane : Fin B) : Nat :=
  (pid*4 + field.val)*B + lane.val

theorem wrapper_block_legal (N : Nat) : LegalBlock (wrapperBlock N) := by
  unfold wrapperBlock
  split
  · exact ⟨9, by decide, by decide⟩
  · exact ⟨10, by decide, by decide⟩

theorem legalBlock_fields {B : Nat} (hB : LegalBlock B) :
    0 < B ∧ B ≤ 2^20 ∧ 4*B < 2^31 ∧ 4*B ∣ 2^31 := by
  obtain ⟨k, hk, rfl⟩ := hB
  have hb : (2:Nat)^k ≤ 2^20 := Nat.pow_le_pow_right (by decide) hk
  have hp : 4 * (2:Nat)^k = 2^(k+2) := by
    rw [Nat.pow_add]
    norm_num
    omega
  refine ⟨by positivity, hb, by omega, ?_⟩
  rw [hp]
  exact Nat.pow_dvd_pow 2 (by omega)

theorem grid_zero (B : Nat) : grid 0 B = 0 := by
  change (0 : Nat) ⌈/⌉ (4*B) = 0
  simp

theorem grid_le_i32_blocks {N B : Nat} (hB : LegalBlock B) (hN : N < 2^31) :
    grid N B ≤ 2^31 / (4*B) := by
  have hf := legalBlock_fields hB
  change N ⌈/⌉ (4*B) ≤ 2^31 / (4*B)
  apply (ceilDiv_le_iff_le_mul (by omega : 0 < 4*B)).mpr
  rw [Nat.mul_div_cancel' hf.2.2.2]
  exact hN.le

theorem launched_all_lanes_lt_i32 {N B pid : Nat} (hB : LegalBlock B)
    (hN : N < 2^31) (hpid : pid < grid N B) (field : Fin 4) (lane : Fin B) :
    outputIndex pid B field lane < 2^31 := by
  have hg := grid_le_i32_blocks hB hN
  have hf := legalBlock_fields hB
  have hblock : (pid+1)*(4*B) ≤ (2^31/(4*B))*(4*B) :=
    Nat.mul_le_mul_right (4*B) (by omega)
  rw [Nat.div_mul_cancel hf.2.2.2] at hblock
  have hfield : field.val*B ≤ 3*B := Nat.mul_le_mul_right B (by omega)
  unfold outputIndex
  nlinarith [lane.isLt]

theorem counter_index_lt_i32 {N B pid lane : Nat} (hB : LegalBlock B)
    (hN : N < 2^31) (hpid : pid < grid N B) (hlane : lane < B) :
    counterIndex pid B lane < 2^31 := by
  have h := launched_all_lanes_lt_i32 hB hN hpid ⟨0, by decide⟩ ⟨lane, hlane⟩
  simp only [outputIndex, Nat.add_zero] at h
  unfold counterIndex
  nlinarith

theorem output_div {B : Nat} (hB : 0 < B) (pid : Nat) (f : Fin 4) (i : Fin B) :
    outputIndex pid B f i / B = pid*4+f.val := by
  simpa [outputIndex, Nat.mul_comm, Nat.div_eq_of_lt i.isLt] using
    Nat.mul_add_div hB (pid*4+f.val) i.val

theorem output_mod (pid B : Nat) (f : Fin 4) (i : Fin B) :
    outputIndex pid B f i % B = i.val := by
  simp [outputIndex, Nat.add_mod, Nat.mod_eq_of_lt i.isLt]

/-- The four stores have disjoint addresses within and across programs. -/
theorem output_unique {B pid otherPid : Nat} (hB : 0 < B)
    (f g : Fin 4) (i j : Fin B)
    (h : outputIndex pid B f i = outputIndex otherPid B g j) :
    pid = otherPid ∧ f = g ∧ i = j := by
  have hdiv := congrArg (fun n => n/B) h
  have hmod := congrArg (fun n => n%B) h
  dsimp only at hdiv hmod
  rw [output_div hB, output_div hB] at hdiv
  rw [output_mod, output_mod] at hmod
  have hp : pid = otherPid := by omega
  have hf : f = g := Fin.ext (by omega)
  exact ⟨hp, hf, Fin.ext hmod⟩

theorem quotient_lt_grid {N B k : Nat} (hB : 0 < B) (hk : k < N) :
    k / (4*B) < grid N B := by
  have hcover : N ≤ (4*B)*grid N B :=
    (ceilDiv_le_iff_le_mul (by omega : 0 < 4*B)).mp
      (show N ⌈/⌉ (4*B) ≤ grid N B from le_rfl)
  have hquot : (4*B)*(k/(4*B)) ≤ k := by
    simpa [Nat.mul_comm] using Nat.div_mul_le_self k (4*B)
  by_contra h
  have hmul := Nat.mul_le_mul_left (4*B) (Nat.le_of_not_gt h)
  omega

/-- Every active output is generated by exactly one of the four stores. -/
theorem active_coverage_unique {N B k : Nat} (hB : 0 < B) (hk : k < N) :
    ∃! pfl : Fin (grid N B) × Fin 4 × Fin B,
      outputIndex pfl.1.val B pfl.2.1 pfl.2.2 = k := by
  let p : Fin (grid N B) := ⟨k/(4*B), quotient_lt_grid hB hk⟩
  let f : Fin 4 := ⟨(k/B)%4, Nat.mod_lt _ (by decide)⟩
  let i : Fin B := ⟨k%B, Nat.mod_lt _ hB⟩
  have hpid : k/(4*B) = k/B/4 := by rw [Nat.div_div_eq_div_mul, Nat.mul_comm]
  have hsplit := Nat.div_add_mod (k/B) 4
  have hlane := Nat.div_add_mod k B
  have heq : outputIndex p.val B f i = k := by
    dsimp only [outputIndex, p, f, i]
    rw [hpid]
    nlinarith
  refine ⟨(p, f, i), heq, ?_⟩
  intro other ho
  have hu := output_unique hB other.2.1 f other.2.2 i (ho.trans heq.symm)
  exact Prod.ext (Fin.ext hu.1) (Prod.ext hu.2.1 hu.2.2)

#axiomsClean wrapper_block_legal
#axiomsClean legalBlock_fields
#axiomsClean grid_zero
#axiomsClean launched_all_lanes_lt_i32
#axiomsClean counter_index_lt_i32
#axiomsClean output_unique
#axiomsClean active_coverage_unique

end VeriTile.Bench.TritonBenchG.UniformSampling.SourceDomain
