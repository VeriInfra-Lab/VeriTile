import bench.tritonbench_g.streamk_matmul.Proofs.StreamK_Schedule
namespace VeriTile.Bench.Repairs.StreamK.Whole001
namespace Schedule
open Source Plan Protocol
set_option maxHeartbeats 16000000
noncomputable section

theorem tile_pair_origin (p : Parameters) (tile : Nat) (pair : C p × S p)
    (h : pair ∈ tilePairs p tile) :
    ∃ lane : Lane p, ∃ ha : active p tile lane, pair.1=output p tile lane ha := by
  unfold tilePairs at h
  obtain ⟨pr,hpr,h⟩:=List.mem_flatMap.mp h
  unfold programPairs at h
  split at h
  next hr =>
    obtain ⟨lane,hl,h⟩:=List.mem_flatMap.mp h
    split at h
    next ha =>
      simp only [List.mem_singleton] at h
      subst pair
      exact ⟨lane,ha,rfl⟩
    next ha => simp at h
  next hr => simp at h

/-- This disjointness theorem is source-specific: it uses the actual grouped
mapping, masks, output strides, and both reducer CTAs' launch bounds. -/
theorem reducer_ctas_disjoint (p : Parameters) (tile other : Nat)
    (ht : tile < (select p.h).streamTiles) (ho : other < (select p.h).streamTiles)
    (hne : tile≠other) (a b : C p × S p) (ha : a ∈ tilePairs p tile) (hb : b ∈ tilePairs p other) :
    a.1≠b.1 := by
  obtain ⟨l,hl,ha'⟩:=tile_pair_origin p tile a ha
  obtain ⟨k,hk,hb'⟩:=tile_pair_origin p other b hb
  intro he
  rw [ha',hb'] at he
  exact hne (output_address_unique p tile other
    (lt_of_lt_of_le ht (selected_bounded p.h)) (lt_of_lt_of_le ho (selected_bounded p.h)) l k hl hk he).1

abbrev Tagged (p : Parameters) := Nat × (C p × S p)
def tagged (p : Parameters) : List (Tagged p) :=
  (List.range (select p.h).streamTiles).flatMap fun tile=>(tilePairs p tile).map fun pair=>(tile,pair)

theorem tagged_origin (p : Parameters) (entry : Tagged p) (h : entry ∈ tagged p) :
    entry.1 < (select p.h).streamTiles ∧ entry.2 ∈ tilePairs p entry.1 := by
  unfold tagged at h
  obtain ⟨tile,ht,h⟩:=List.mem_flatMap.mp h
  obtain ⟨pair,hpair,he⟩:=List.mem_map.mp h
  subst entry
  exact ⟨List.mem_range.mp ht,hpair⟩

/-- All complete interleavings preserving each CTA's local instruction order
are generated by adjacent swaps of instructions from distinct CTA owners.
The relation contains only integer owners and finite address pairs. -/
inductive Shuffle (owner : β → Nat) : List β → List β → Prop
  | refl (xs : List β) : Shuffle owner xs xs
  | swap (before after : List β) (a b : β) (h : owner a≠owner b) :
      Shuffle owner (before++a::b::after) (before++b::a::after)
  | trans {xs ys zs : List β} : Shuffle owner xs ys → Shuffle owner ys zs → Shuffle owner xs zs

theorem shuffle_perm (owner : β → Nat) (xs ys : List β) (h : Shuffle owner xs ys) : xs.Perm ys := by
  induction h with
  | refl xs => exact List.Perm.refl _
  | swap before after a b h => exact (List.Perm.swap b a after).append_left before
  | trans h1 h2 ih1 ih2 => exact ih1.trans ih2

def projection (p : Parameters) (i : C p) (xs : List (Tagged p)) :=
  (xs.map Prod.snd).filter (fun pair=>pair.1==i)

theorem shuffle_projection (p : Parameters) (xs ys : List (Tagged p))
    (h : Shuffle Prod.fst xs ys) (hx : xs.Perm (tagged p)) (i : C p) :
    projection p i xs=projection p i ys := by
  induction h with
  | refl xs => rfl
  | swap before after a b h =>
    have ha:=tagged_origin p a (hx.mem_iff.mp (by simp))
    have hb:=tagged_origin p b (hx.mem_iff.mp (by simp))
    have hd:=reducer_ctas_disjoint p a.1 b.1 ha.1 hb.1 h a.2 b.2 ha.2 hb.2
    simpa only [projection,List.map_append,List.map_cons] using
      distinct_atomic_swap (before.map Prod.snd) (after.map Prod.snd) a.2 b.2 hd i
  | trans h1 h2 ih1 ih2 =>
    exact (ih1 hx).trans (ih2 ((shuffle_perm _ _ _ h1).symm.trans hx))

structure CTAInterleaving (p : Parameters) where
  events : List (Tagged p)
  order : Shuffle Prod.fst (tagged p) events

theorem interleaving_complete (p : Parameters) (schedule : CTAInterleaving p) :
    schedule.events.length=(tagged p).length :=
  (shuffle_perm _ _ _ schedule.order).length_eq.symm

theorem tagged_pairs (p : Parameters) : (tagged p).map Prod.snd=reducePairs p := by
  simp [tagged,reducePairs,List.map_flatMap,List.map_map]

theorem source_per_output (p : Parameters) (schedule : CTAInterleaving p) (i : C p) :
    (schedule.events.map Prod.snd).filter (fun pair=>pair.1==i)=
      (reducePairs p).filter (fun pair=>pair.1==i) := by
  have hp:=shuffle_projection p _ _ schedule.order (List.Perm.refl _) i
  unfold projection at hp
  rw [tagged_pairs] at hp
  exact hp.symm

theorem reduce_interleaving (p : Parameters) (schedule : CTAInterleaving p)
    (add : α → α → α) (initial : State α p exterior) :
    Memory.run add ((schedule.events.map Prod.snd).map fun pair=>.atomic pair.1 pair.2) initial=
      Memory.run add (reduceWave p) initial := by
  unfold reduceWave
  apply Memory.state_ext
  · exact (Memory.run_inputs _ _ _).1.trans (Memory.run_inputs _ _ _).1.symm
  · exact (Memory.run_inputs _ _ _).2.1.trans (Memory.run_inputs _ _ _).2.1.symm
  · funext i
    rw [Memory.atomic_projection,Memory.atomic_projection]
    have hf:(fun z (pair : C p × S p)=>if pair.1=i then add z (initial.scratch pair.2) else z)=
        (fun z (pair : C p × S p)=>if pair.1==i then add z (initial.scratch pair.2) else z) := by
      funext z pair
      simp
    rw [hf,Memory.fold_filter,Memory.fold_filter,source_per_output p schedule i]
  · rw [Memory.atomic_scratch_frame,Memory.atomic_scratch_frame]
  · exact (Memory.run_inputs _ _ _).2.2.trans (Memory.run_inputs _ _ _).2.2.symm

/-- All three completed launches admit arbitrary first/full store schedules
and all reducer CTA interleavings, with the required same-stream boundaries. -/
def call (p : Parameters) (ops : Instructions α)
    (first : Order (firstWave p ops).length) (reduce : CTAInterleaving p)
    (last : Order (fullWave p ops).length) (initial : State α p exterior) : State α p exterior :=
  if p.h.m=0 ∨ p.h.n=0 then initial else
    Memory.run ops.atomicAdd (reorder (fullWave p ops) last)
      (Memory.run ops.atomicAdd ((reduce.events.map Prod.snd).map fun pair=>.atomic pair.1 pair.2)
        (Memory.run ops.atomicAdd (reorder (firstWave p ops) first) initial))

theorem call_eq (p : Parameters) (ops : Instructions α)
    (first : Order (firstWave p ops).length) (reduce : CTAInterleaving p)
    (last : Order (fullWave p ops).length) (initial : State α p exterior) :
    call p ops first reduce last initial=Source.call p ops initial := by
  unfold call Source.call
  split
  · rfl
  · rw [first_reordering,reduce_interleaving,full_reordering]

#axiomsClean reducer_ctas_disjoint
#axiomsClean interleaving_complete
#axiomsClean source_per_output
#axiomsClean call_eq
#specNonCircular CTAInterleaving avoiding [call,Source.call,Memory.run,Memory.step]
end
end Schedule
end VeriTile.Bench.Repairs.StreamK.Whole001
