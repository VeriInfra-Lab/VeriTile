import VeriTile.Triton.Source
import Mathlib.Tactic
import VeriTile.Meta.StatementAudit
import VeriTile.Triton.DSL

namespace VeriTile.Bench.Repairs.Int4Matmul.KernelSource
open VeriTile.Triton
noncomputable section

structure Parameters where
  (input weight output scale zero : RegionName)
  (rows columns inner inputRowStride inputInnerStride weightInnerStride weightColumnStride
    outputRowStride outputColumnStride scaleGroupStride scaleColumnStride
    zeroGroupStride zeroColumnStride groupSize blockRows blockColumns blockInner
    groupRows splits : Nat)

def steps (p : Parameters) : Nat :=
  (p.inner + p.blockInner * p.splits - 1) / (p.blockInner * p.splits)

/-- The complete canonical FP32 kernel. All four K masks, split traversal,
actual tensor strides, packed words and the store/atomic branches are retained.
The arithmetic interpreter binds the compiler's local dot/add realization;
no alternate handwritten kernel AST is maintained. -/
def kernel (p : Parameters) : ComputeKernel :=
  let a_ptr := p.input
  let b_ptr := p.weight
  let c_ptr := p.output
  let bs_ptr := p.scale
  let bzp_ptr := p.zero
  triton {
    tl.region a_ptr = tl.float32, b_ptr = tl.int32, c_ptr = tl.float32,
      bs_ptr = tl.float32, bzp_ptr = tl.int32
    pid = tl.program_id(axis=0)
    pid_sp_k = tl.program_id(axis=1)
    num_pid_m = tl.cdiv($(p.rows), $(p.blockRows))
    num_pid_n = tl.cdiv($(p.columns), $(p.blockColumns))
    num_pid_k = tl.cdiv($(p.inner), $(p.blockInner))
    num_pid_in_group = $(p.groupRows) * num_pid_n
    group_id = pid // num_pid_in_group
    first_pid_m = group_id * $(p.groupRows)
    group_size_m = min(num_pid_m - first_pid_m, $(p.groupRows))
    pid_m = first_pid_m + (pid % group_size_m)
    pid_n = (pid % num_pid_in_group) // group_size_m
    offs_am = (pid_m * $(p.blockRows) + tl.arange(0, $(p.blockRows))) % $(p.rows)
    offs_bn = (pid_n * $(p.blockColumns) + tl.arange(0, $(p.blockColumns))) % $(p.columns)
    offs_k = pid_sp_k * $(p.blockInner) + tl.arange(0, $(p.blockInner))
    a_ptrs = a_ptr + (offs_am[:, None] * $(p.inputRowStride) + offs_k[None, :] * $(p.inputInnerStride))
    b_ptrs = b_ptr + ((offs_k[:, None] // $(8)) * $(p.weightInnerStride) + offs_bn[None, :] * $(p.weightColumnStride))
    accumulator = tl.zeros([$(p.blockRows), $(p.blockColumns)], dtype=tl.float32)
    for k in range($(0), $(steps p), $(1)) {
      bs_ptrs = bs_ptr + (((offs_k[:, None] + k * $(p.blockInner) * $(p.splits)) // $(p.groupSize)) * $(p.scaleGroupStride) + offs_bn[None, :] * $(p.scaleColumnStride))
      bzp_ptrs = bzp_ptr + (((offs_k[:, None] + k * $(p.blockInner) * $(p.splits)) // $(p.groupSize)) * $(p.zeroGroupStride) + (offs_bn[None, :] // $(8)) * $(p.zeroColumnStride))
      b_shift_bits = (offs_k[:, None] % $(8)) * $(4)
      bzp_shift_bits = (offs_bn[None, :] % $(8)) * $(4)
      k_mask = offs_k + k * $(p.blockInner) * $(p.splits) < $(p.inner)
      a = tl.load(a_ptrs, mask=k_mask[None, :], other=0)
      b = tl.load(b_ptrs, mask=k_mask[:, None], other=0)
      bs = tl.load(bs_ptrs, mask=k_mask[:, None], other=0)
      bzp = tl.load(bzp_ptrs, mask=k_mask[:, None], other=0)
      int_b = (b >> b_shift_bits) & 15
      int_bzp = (bzp >> bzp_shift_bits) & 15
      b = ((int_b - int_bzp) * bs).to(a.dtype)
      accumulator += tl.dot(a, (b).to(a.dtype))
      a_ptrs += $(p.blockInner) * $(p.splits) * $(p.inputInnerStride)
      b_ptrs += ($(p.blockInner) * $(p.splits) * $(p.weightInnerStride) // $(8))
    }
    c = (accumulator).to(c_ptr.dtype.element_ty)
    offs_cm = pid_m * $(p.blockRows) + tl.arange(0, $(p.blockRows))
    offs_cn = pid_n * $(p.blockColumns) + tl.arange(0, $(p.blockColumns))
    c_ptrs = c_ptr + $(p.outputRowStride) * offs_cm[:, None] + $(p.outputColumnStride) * offs_cn[None, :]
    c_mask = (offs_cm[:, None] < $(p.rows)) & (offs_cn[None, :] < $(p.columns))
    if $(p.splits) == $(1) {
      tl.store(c_ptrs, c, mask=c_mask)
    } else {
      tl.atomic_add(c_ptrs, c, mask=c_mask)
    }
  }

/-- Precombine the constexpr inner traversal stride in each dynamic k offset. -/
def foldStrideKernel (p : Parameters) : ComputeKernel :=
  let a_ptr := p.input
  let b_ptr := p.weight
  let c_ptr := p.output
  let bs_ptr := p.scale
  let bzp_ptr := p.zero
  triton {
    tl.region a_ptr = tl.float32, b_ptr = tl.int32, c_ptr = tl.float32,
      bs_ptr = tl.float32, bzp_ptr = tl.int32
    pid = tl.program_id(axis=0)
    pid_sp_k = tl.program_id(axis=1)
    num_pid_m = tl.cdiv($(p.rows), $(p.blockRows))
    num_pid_n = tl.cdiv($(p.columns), $(p.blockColumns))
    num_pid_k = tl.cdiv($(p.inner), $(p.blockInner))
    num_pid_in_group = $(p.groupRows) * num_pid_n
    group_id = pid // num_pid_in_group
    first_pid_m = group_id * $(p.groupRows)
    group_size_m = min(num_pid_m - first_pid_m, $(p.groupRows))
    pid_m = first_pid_m + (pid % group_size_m)
    pid_n = (pid % num_pid_in_group) // group_size_m
    offs_am = (pid_m * $(p.blockRows) + tl.arange(0, $(p.blockRows))) % $(p.rows)
    offs_bn = (pid_n * $(p.blockColumns) + tl.arange(0, $(p.blockColumns))) % $(p.columns)
    offs_k = pid_sp_k * $(p.blockInner) + tl.arange(0, $(p.blockInner))
    a_ptrs = a_ptr + (offs_am[:, None] * $(p.inputRowStride) + offs_k[None, :] * $(p.inputInnerStride))
    b_ptrs = b_ptr + ((offs_k[:, None] // $(8)) * $(p.weightInnerStride) + offs_bn[None, :] * $(p.weightColumnStride))
    accumulator = tl.zeros([$(p.blockRows), $(p.blockColumns)], dtype=tl.float32)
    for k in range($(0), $(steps p), $(1)) {
      bs_ptrs = bs_ptr + (((offs_k[:, None] + k * $(p.blockInner * p.splits)) // $(p.groupSize)) * $(p.scaleGroupStride) + offs_bn[None, :] * $(p.scaleColumnStride))
      bzp_ptrs = bzp_ptr + (((offs_k[:, None] + k * $(p.blockInner * p.splits)) // $(p.groupSize)) * $(p.zeroGroupStride) + (offs_bn[None, :] // $(8)) * $(p.zeroColumnStride))
      b_shift_bits = (offs_k[:, None] % $(8)) * $(4)
      bzp_shift_bits = (offs_bn[None, :] % $(8)) * $(4)
      k_mask = offs_k + k * $(p.blockInner * p.splits) < $(p.inner)
      a = tl.load(a_ptrs, mask=k_mask[None, :], other=0)
      b = tl.load(b_ptrs, mask=k_mask[:, None], other=0)
      bs = tl.load(bs_ptrs, mask=k_mask[:, None], other=0)
      bzp = tl.load(bzp_ptrs, mask=k_mask[:, None], other=0)
      int_b = (b >> b_shift_bits) & 15
      int_bzp = (bzp >> bzp_shift_bits) & 15
      b = ((int_b - int_bzp) * bs).to(a.dtype)
      accumulator += tl.dot(a, (b).to(a.dtype))
      a_ptrs += $(p.blockInner) * $(p.splits) * $(p.inputInnerStride)
      b_ptrs += ($(p.blockInner) * $(p.splits) * $(p.weightInnerStride) // $(8))
    }
    c = (accumulator).to(c_ptr.dtype.element_ty)
    offs_cm = pid_m * $(p.blockRows) + tl.arange(0, $(p.blockRows))
    offs_cn = pid_n * $(p.blockColumns) + tl.arange(0, $(p.blockColumns))
    c_ptrs = c_ptr + $(p.outputRowStride) * offs_cm[:, None] + $(p.outputColumnStride) * offs_cn[None, :]
    c_mask = (offs_cm[:, None] < $(p.rows)) & (offs_cn[None, :] < $(p.columns))
    if $(p.splits) == $(1) {
      tl.store(c_ptrs, c, mask=c_mask)
    } else {
      tl.atomic_add(c_ptrs, c, mask=c_mask)
    }
  }


end
end VeriTile.Bench.Repairs.Int4Matmul.KernelSource

namespace VeriTile.Bench.Repairs.Int4Matmul
set_option maxHeartbeats 4000000
abbrev Word := BitVec 32
inductive Region where
  | a | scale | output | weight | unpacked | other (n : Nat)
  deriving DecidableEq, Repr
inductive PackedRegion where
  | weight | zero
  deriving DecidableEq, Repr
abbrev Memory (α : Type) := Region → Nat → α
structure State (α : Type) where
  values : Memory α
  packed : PackedRegion → Nat → Word

structure Shape where
  m : Nat
  n : Nat
  k : Nat
  group : Nat
  deriving DecidableEq, Repr
structure Tile where
  bm : Nat
  bn : Nat
  bk : Nat
  gm : Nat
  splits : Nat
  deriving DecidableEq, Repr
structure Shape.Valid (s : Shape) : Prop where
  mpos : 0<s.m
  npos : 0<s.n
  kpos : 0<s.k
  gpos : 0<s.group
  k8 : 8∣s.k
  n8 : 8∣s.n
  groups : s.group∣s.k
structure Tile.Valid (t : Tile) : Prop where
  bmpos : 0<t.bm
  bnpos : 0<t.bn
  bkpos : 0<t.bk
  gmpos : 0<t.gm
  splits : t.splits=1 ∨ t.splits=2
  bk8 : 8∣t.bk

def ceil (a b : Nat) := (a+b-1)/b
def blocksM (s : Shape) (t : Tile) := ceil s.m t.bm
def blocksN (s : Shape) (t : Tile) := ceil s.n t.bn
def rounds (s : Shape) (t : Tile) := ceil s.k (t.bk*t.splits)
def kIndex (t : Tile) (split block lane : Nat) := split*t.bk+block*t.bk*t.splits+lane
/-- Unsigned nibble meaning is independent of signed storage representation. -/
def nibble (w : Word) (slot : Nat) : Int :=
  ((w >>> (slot%8*4)) &&& (15 : Word)).toInt

def aAddress (s : Shape) (r k : Nat) := r*s.k+k
def qAddress (s : Shape) (k c : Nat) := (k/8)*s.n+c
def sAddress (s : Shape) (k c : Nat) := (k/s.group)*s.n+c
def zAddress (s : Shape) (k c : Nat) := (k/s.group)*(s.n/8)+c/8
def cAddress (s : Shape) (r c : Nat) := r*s.n+c
/-- Fixed eight-product ISA projection; arity never depends on M,N,K or tile BK.
The ISA variant and register mapping are bound by the recorded compiler profiles.
This is not a whole dot, block or output oracle. -/
structure Ops (α : Type) where
  zero : α
  fromInt : Int → α
  mul : α → α → α
  atomicAdd : α → α → α
  dot8 : (Fin 8 → α) → (Fin 8 → α) → α → α

structure Work where
  row : Nat
  col : Nat
  split : Nat
  deriving DecidableEq, Repr

def Shape.Active (s : Shape) (t : Tile) (w : Work) :=
  w.row<s.m ∧ w.col<s.n ∧ w.split<t.splits
instance (s : Shape) (t : Tile) (w : Work) : Decidable (s.Active t w) := inferInstanceAs (Decidable (_∧_∧_))

def difference (s : Shape) (m : State α) (k col : Nat) : Int :=
  nibble (m.packed .weight (qAddress s k col)) k -
    nibble (m.packed .zero (zAddress s k col)) col

def operandA (s : Shape) (p : Ops α) (m : State α) (row k : Nat) :=
  if k<s.k then m.values .a (aAddress s (row%s.m) k) else p.zero

def operandB (s : Shape) (p : Ops α) (m : State α) (col k : Nat) :=
  if k<s.k then p.mul (p.fromInt (difference s m k (col%s.n)))
    (m.values .scale (sAddress s k (col%s.n)))
  else p.mul (p.fromInt 0) p.zero

/-- All four source loads use the same K predicate. Dot chunks preserve the
carried accumulator observed in every offline selected profile. -/
def blockStep (s : Shape) (t : Tile) (p : Ops α) (m : State α)
    (w : Work) (block : Nat) (seed : α) : α :=
  (List.range (t.bk/8)).foldl (fun acc chunk =>
    p.dot8 (fun i => operandA s p m w.row (kIndex t w.split block (chunk*8+i)))
      (fun i => operandB s p m w.col (kIndex t w.split block (chunk*8+i))) acc) seed

def partialValue (s : Shape) (t : Tile) (p : Ops α) (m : State α) (w : Work) :=
  (List.range (rounds s t)).foldl (fun acc block => blockStep s t p m w block acc) p.zero

def store (m : State α) (r : Region) (a : Nat) (v : α) : State α :=
  {m with values := fun q b => if q=r ∧ b=a then v else m.values q b}
def step (s : Shape) (t : Tile) (p : Ops α) (w : Work) (m : State α) : State α :=
  let v := partialValue s t p m w
  let a := cAddress s w.row w.col
  store m .output a (if t.splits=1 then v else p.atomicAdd (m.values .output a) v)
def execute (s : Shape) (t : Tile) (p : Ops α) : List Work → State α → State α
  | [],m => m
  | w::ws,m => execute s t p ws (step s t p w m)
def zeroOutput (s : Shape) (p : Ops α) (m : State α) : State α :=
  {m with values := fun r a => if r=.output ∧ a<s.m*s.n then p.zero else m.values r a}
end VeriTile.Bench.Repairs.Int4Matmul

