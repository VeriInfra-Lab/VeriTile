import bench.repairs.tritonbench_g.diag_ssm_triton.Proofs.RealGraph

/-! Numerical obligations are local to evaluated scalar primitives. The total
Word execution remains defined for every FP32 bit pattern. Only the numerical
bridge uses finite projections. Each residual below is attached to the actual
operands of add/sub/mul/FMA/sign-bit operations, never to a kernel or sum result.
Expression trees are generated by the shared scalar graphs; expanding shared
SSA operands here is not a claim about native instruction counts. -/
namespace VeriTile.Bench.Repairs.DiagSsmTriton.PrimitiveNumerics
open Kernels
set_option autoImplicit false
noncomputable section

abbrev Finite (w : Word) : Prop := w.toRat?.isSome = Bool.true

def real (w : Word) : ℝ := ((w.toRat?.getD 0 : Rat) : ℝ)

inductive Atom where
  | zero
  | add (a b : Word)
  | subtract (a b : Word)
  | multiply (a b : Word)
  | fma (a b c : Word)
  | flipSign (a : Word)

def Atom.inputs : Atom → List Word
  | .zero => []
  | .add a b | .subtract a b | .multiply a b => [a, b]
  | .fma a b c => [a, b, c]
  | .flipSign a => [a]

def Atom.result (ops : Operations Word) : Atom → Word
  | .zero => ops.zero
  | .add a b => ops.add a b
  | .subtract a b => ops.subtract a b
  | .multiply a b => ops.multiply a b
  | .fma a b c => ops.fma a b c
  | .flipSign a => ops.flipSign a

def Atom.ideal : Atom → ℝ
  | .zero => 0
  | .add a b => real a + real b
  | .subtract a b => real a - real b
  | .multiply a b => real a * real b
  | .fma a b c => real a * real b + real c
  | .flipSign a => -real a

def Atom.residual (ops : Operations Word) (atom : Atom) : ℝ := real (atom.result ops) - atom.ideal

/-- A deferred finite numerical bound for one actual primitive. The operation,
all evaluated operands, result precision, and selected backend/configuration
are explicit in `atom` and `ops`. No exact mul/add-to-FMA law is present. -/
structure LocalBound (ops : Operations Word) (atom : Atom) (bound : ℝ) : Prop where
  inputs : ∀ w ∈ atom.inputs, Finite w
  output : Finite (atom.result ops)
  error : |atom.residual ops| ≤ bound

inductive Expr where
  | leaf (word : Word)
  | zero
  | add (a b : Expr)
  | subtract (a b : Expr)
  | multiply (a b : Expr)
  | fma (a b c : Expr)
  | flipSign (a : Expr)

def expressionOps : Operations Expr :=
  ⟨.zero, .add, .subtract, .multiply, .fma, .flipSign⟩

def Expr.evaluate (ops : Operations Word) : Expr → Word
  | .leaf w => w
  | .zero => ops.zero
  | .add a b => ops.add (a.evaluate ops) (b.evaluate ops)
  | .subtract a b => ops.subtract (a.evaluate ops) (b.evaluate ops)
  | .multiply a b => ops.multiply (a.evaluate ops) (b.evaluate ops)
  | .fma a b c => ops.fma (a.evaluate ops) (b.evaluate ops) (c.evaluate ops)
  | .flipSign a => ops.flipSign (a.evaluate ops)

def Expr.ideal : Expr → ℝ
  | .leaf w => real w
  | .zero => 0
  | .add a b => a.ideal + b.ideal
  | .subtract a b => a.ideal - b.ideal
  | .multiply a b => a.ideal * b.ideal
  | .fma a b c => a.ideal * b.ideal + c.ideal
  | .flipSign a => -a.ideal

/-- Every leaf is an actual loaded/register word; every internal atom carries
the already evaluated operands, including fused versus separate operations. -/
def Expr.atoms (ops : Operations Word) : Expr → List Atom
  | .leaf _ => []
  | .zero => [.zero]
  | .add a b => a.atoms ops ++ b.atoms ops ++ [.add (a.evaluate ops) (b.evaluate ops)]
  | .subtract a b => a.atoms ops ++ b.atoms ops ++ [.subtract (a.evaluate ops) (b.evaluate ops)]
  | .multiply a b => a.atoms ops ++ b.atoms ops ++ [.multiply (a.evaluate ops) (b.evaluate ops)]
  | .fma a b c => a.atoms ops ++ b.atoms ops ++ c.atoms ops ++ [.fma (a.evaluate ops) (b.evaluate ops) (c.evaluate ops)]
  | .flipSign a => a.atoms ops ++ [.flipSign (a.evaluate ops)]

/-- Residual propagation is algebraic and uses primitive residuals at their
actual arguments. Multiplication includes the cross term; FMA rounds once. -/
def Expr.error (ops : Operations Word) : Expr → ℝ
  | .leaf _ => 0
  | .zero => Atom.residual ops .zero
  | .add a b => a.error ops + b.error ops + Atom.residual ops (.add (a.evaluate ops) (b.evaluate ops))
  | .subtract a b => a.error ops - b.error ops + Atom.residual ops (.subtract (a.evaluate ops) (b.evaluate ops))
  | .multiply a b => a.ideal * b.error ops + a.error ops * b.ideal + a.error ops * b.error ops +
      Atom.residual ops (.multiply (a.evaluate ops) (b.evaluate ops))
  | .fma a b c => a.ideal * b.error ops + a.error ops * b.ideal + a.error ops * b.error ops + c.error ops +
      Atom.residual ops (.fma (a.evaluate ops) (b.evaluate ops) (c.evaluate ops))
  | .flipSign a => -a.error ops + Atom.residual ops (.flipSign (a.evaluate ops))

theorem Expr.error_exact (ops : Operations Word) (expression : Expr) :
    real (expression.evaluate ops) = expression.ideal + expression.error ops := by
  induction expression with
  | leaf word => simp [Expr.evaluate, Expr.ideal, Expr.error]
  | zero => simp [Expr.evaluate, Expr.ideal, Expr.error, Atom.residual, Atom.result, Atom.ideal]
  | add a b ha hb =>
    simp only [Expr.evaluate, Expr.ideal, Expr.error, Atom.residual, Atom.result, Atom.ideal]
    rw [ha, hb]
    ring
  | subtract a b ha hb =>
    simp only [Expr.evaluate, Expr.ideal, Expr.error, Atom.residual, Atom.result, Atom.ideal]
    rw [ha, hb]
    ring
  | multiply a b ha hb =>
    simp only [Expr.evaluate, Expr.ideal, Expr.error, Atom.residual, Atom.result, Atom.ideal]
    rw [ha, hb]
    ring
  | fma a b c ha hb hc =>
    simp only [Expr.evaluate, Expr.ideal, Expr.error, Atom.residual, Atom.result, Atom.ideal]
    rw [ha, hb, hc]
    ring
  | flipSign a ha =>
    simp only [Expr.evaluate, Expr.ideal, Expr.error, Atom.residual, Atom.result, Atom.ideal]
    rw [ha]
    ring

/-- Finite projections are requested for actual leaf and result words. Local
bounds are a separate optional numerical premise; total execution does not use
this predicate and continues to include NaN, infinities and signed zero. -/
def Domain (ops : Operations Word) (expression : Expr) : Prop :=
  (∀ atom ∈ expression.atoms ops, (∀ w ∈ atom.inputs, Finite w) ∧ Finite (atom.result ops)) ∧
    Finite (expression.evaluate ops)

def Leaves (pair : Pair Word) : Pair Expr := ⟨.leaf pair.re, .leaf pair.im⟩
def evalPair (ops : Operations Word) (pair : Pair Expr) : Pair Word := ⟨pair.re.evaluate ops, pair.im.evaluate ops⟩
def realPair (pair : Pair Word) : Pair ℝ := ⟨real pair.re, real pair.im⟩
def idealPair (pair : Pair Expr) : Pair ℝ := ⟨pair.re.ideal, pair.im.ideal⟩
def errorPair (ops : Operations Word) (pair : Pair Expr) : Pair ℝ := ⟨pair.re.error ops, pair.im.error ops⟩

def project (route : Route) (pair : Pair ℝ) : ℂ :=
  match route with
  | .real32 => ⟨pair.re, 0⟩
  | .complex64 => ⟨pair.re, pair.im⟩

def observe (route : Route) (z : ℂ) : ℂ :=
  match route with
  | .real32 => z
  | .complex64 => starRingEnd ℂ z

theorem pair_error (ops : Operations Word) (route : Route) (pair : Pair Expr) :
    project route (realPair (evalPair ops pair)) =
      project route (idealPair pair) + project route (errorPair ops pair) := by
  cases route <;> apply Complex.ext <;>
    simp [project, realPair, evalPair, idealPair, errorPair, Expr.error_exact]

def forwardExpr (route : Route) (graph : Graph) (s transition x : Pair Word) : Pair Expr :=
  Kernels.forward route graph expressionOps (Leaves s) (Leaves transition) (Leaves x)

theorem eval_forward (ops : Operations Word) (route : Route) (graph : Graph) (s transition x : Pair Word) :
    evalPair ops (forwardExpr route graph s transition x) = Kernels.forward route graph ops s transition x := by
  cases route <;> cases graph <;> rfl

theorem ideal_forward (route : Route) (graph : Graph) (s transition x : Pair Word) :
    project route (idealPair (forwardExpr route graph s transition x)) =
      project route (realPair s) * project route (realPair transition) + project route (realPair x) := by
  cases route <;> cases graph <;> apply Complex.ext <;>
    simp [forwardExpr, Kernels.forward, realForward, complexForward, complexProduct, expressionOps,
      Leaves, project, idealPair, Expr.ideal, realPair, Complex.mul_re, Complex.mul_im] <;> ring

theorem forward_error (ops : Operations Word) (route : Route) (graph : Graph) (s transition x : Pair Word) :
    project route (realPair (Kernels.forward route graph ops s transition x)) =
      project route (realPair s) * project route (realPair transition) + project route (realPair x) +
        project route (errorPair ops (forwardExpr route graph s transition x)) := by
  rw [← eval_forward, pair_error, ideal_forward]

#guard_msgs (drop info) in
#auditModuleAxioms
end
end VeriTile.Bench.Repairs.DiagSsmTriton.PrimitiveNumerics
