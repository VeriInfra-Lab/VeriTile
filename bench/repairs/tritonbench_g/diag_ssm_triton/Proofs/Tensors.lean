import bench.repairs.tritonbench_g.diag_ssm_triton.Proofs.Execution
import bench.repairs.tritonbench_g.diag_ssm_triton.Proofs.Protocol
import VeriTile.Torch.Tensor

/-! Ordinary tensor descriptors and logical-value binding. Forward admission
requires contiguous resolved tensors. The existing backward contiguous() keeps
its local coordinate-preserving API contract. Nonzero offsets and read-only
aliases remain permitted. No task-output law appears in this module. -/
set_option autoImplicit false
namespace VeriTile.Bench.Repairs.DiagSsmTriton.Tensors
open Kernels ByteMemory

structure Tensor where
  object : Nat
  storage : Nat
  version : Nat
  route : Route
  device : VeriTile.Torch.Device
  shape : List Nat
  view : View
  contiguous : Bool
  negative : Bool
  conjugated : Bool
  /-- Physical scalar-word offset generated by actual strides. -/
  coordinate : Nat → Nat
  bounded : ∀ q, q < shape.prod → ∀ k, k < route.components → coordinate q + k < view.words

def Tensor.count (tensor : Tensor) := tensor.shape.prod

def Dense (tensor : Tensor) : Prop :=
  tensor.contiguous = Bool.true ∧ tensor.view.words = tensor.route.components * tensor.count ∧
    ∀ q, q < tensor.count → tensor.coordinate q = tensor.route.components * q

def Resolved (tensor : Tensor) : Prop := tensor.negative = Bool.false ∧ tensor.conjugated = Bool.false

def logicalWord {α : Type} (codec : Codec α) (signFlip : α → α) (tensor : Tensor)
    (m : Heap) (q k : Nat) : α :=
  let raw := load codec m (tensor.view.address (tensor.coordinate q + k))
  let conjugated := if tensor.conjugated && decide (k = 1) then signFlip raw else raw
  if tensor.negative then signFlip conjugated else conjugated

theorem resolved_word {α : Type} (codec : Codec α) (signFlip : α → α)
    (tensor : Tensor) (m : Heap) (resolved : Resolved tensor) (dense : Dense tensor)
    (q : Nat) (hq : q < tensor.count) (k : Nat) :
    logicalWord codec signFlip tensor m q k =
      load codec m (tensor.view.address (tensor.route.components * q + k)) := by
  simp [logicalWord, resolved.1, resolved.2, dense.2.2 q hq]

def SameShape (before after : Tensor) : Prop := after.route = before.route ∧ after.shape = before.shape

def SameLogical {α : Type} (codec : Codec α) (signFlip : α → α)
    (before after : Tensor) (initial final : Heap) : Prop :=
  SameShape before after ∧ ∀ q, q < before.count → ∀ k, k < before.route.components →
    logicalWord codec signFlip after final q k = logicalWord codec signFlip before initial q k

theorem SameLogical.trans {α : Type} {codec : Codec α} {signFlip : α → α}
    {a b c : Tensor} {m n p : Heap}
    (ab : SameLogical codec signFlip a b m n) (bc : SameLogical codec signFlip b c n p) :
    SameLogical codec signFlip a c m p := by
  refine ⟨⟨bc.1.1.trans ab.1.1, bc.1.2.trans ab.1.2⟩, ?_⟩
  intro q hq k hk
  have hqb : q < b.count := by simpa only [Tensor.count, ab.1.2] using hq
  have hkb : k < b.route.components := by simpa only [ab.1.1] using hk
  exact (bc.2 q hqb k hkb).trans (ab.2 q hq k hk)

/-- The precise local consequence needed by a raw-pointer kernel. No claim
about the kernel output is an input to this theorem. -/
theorem normalized_load {α : Type} (codec : Codec α) (signFlip : α → α)
    (caller normalized : Tensor) (before after : Heap)
    (logical : SameLogical codec signFlip caller normalized before after)
    (dense : Dense normalized) (resolved : Resolved normalized)
    (q : Nat) (hq : q < caller.count) (k : Nat) (hk : k < caller.route.components) :
    load codec after (normalized.view.address (normalized.route.components * q + k)) =
      logicalWord codec signFlip caller before q k := by
  have hqn : q < normalized.count := by simpa only [Tensor.count, logical.1.2] using hq
  rw [← resolved_word codec signFlip normalized after resolved dense q hqn k]
  exact logical.2 q hq k hk

structure ContiguousReply {α : Type} (codec : Codec α) (signFlip : α → α)
    (caller result : Tensor) (before after : Heap) : Prop where
  logical : SameLogical codec signFlip caller result before after
  dense : Dense result
  resolved : Resolved caller → Resolved result
  identity : caller.contiguous = Bool.true → result = caller
  device : result.device = caller.device

structure Saved where
  initial : Tensor
  output : Tensor
  transition : Tensor
  heap : Heap

def SameSavedStorage (saved restored : Tensor) : Prop :=
  restored.storage = saved.storage ∧ restored.version = saved.version ∧
    restored.view = saved.view ∧ restored.route = saved.route ∧ restored.shape = saved.shape ∧
    restored.negative = saved.negative ∧ restored.conjugated = saved.conjugated ∧
    restored.coordinate = saved.coordinate

theorem restored_logical {α : Type} (codec : Codec α) (signFlip : α → α)
    (saved restored : Tensor) (before after : Heap) (same : SameSavedStorage saved restored)
    (frame : Frame before after saved.view.backing) (q : Nat) (hq : q < saved.count)
    (k : Nat) (hk : k < saved.route.components) :
    logicalWord codec signFlip restored after q k = logicalWord codec signFlip saved before q k := by
  rcases same with ⟨_, _, view, _, _, neg, conj, coordinate⟩
  unfold logicalWord
  rw [view, neg, conj, coordinate, Frame.load codec saved.view frame _ (saved.bounded q hq k hk)]

#guard_msgs (drop info) in
#auditModuleAxioms
end VeriTile.Bench.Repairs.DiagSsmTriton.Tensors

namespace VeriTile.Bench.Repairs.DiagSsmTriton.TensorLaws
open Kernels Tensors

structure Layout (route : Route) (shape : List Nat) (tensor : Tensor) : Prop where
  dtype : tensor.route = route
  shape : tensor.shape = shape
  dense : Dense tensor

theorem Layout.words {route : Route} {shape : List Nat} {tensor : Tensor}
    (h : Layout route shape tensor) : tensor.view.words = route.components * shape.prod := by
  simpa [h.dtype, h.shape, Tensor.count] using h.dense.2.1

end VeriTile.Bench.Repairs.DiagSsmTriton.TensorLaws
