def VeriTile.Bench.Repairs.FusedRotaryEmbeddingTileChecked.inputChecks : VeriTile.Bench.Repairs.FusedRotaryEmbedding.Checked.Call →
  VeriTile.Bench.Repairs.FusedRotaryEmbedding.Physical.Bytes → Bool :=
fun c m => VeriTile.Bench.Repairs.FusedRotaryEmbedding.Checked.check c m && tileChecks c.shape
theorem VeriTile.Bench.Repairs.FusedRotaryEmbeddingTileChecked.arange_bounds : ∀
  (c : VeriTile.Bench.Repairs.FusedRotaryEmbedding.Checked.Call)
  (m : VeriTile.Bench.Repairs.FusedRotaryEmbedding.Physical.Bytes),
  inputChecks c m = «true» →
    0 < c.shape.tokens →
      0 < c.shape.halfBlock ∧ c.shape.halfBlock ≤ 1048576 ∧ 0 < c.shape.fullBlock ∧ c.shape.fullBlock ≤ 1048576 :=
fun c m h live =>
  have hf :=
    Or.casesOn ((check_iff c m).mp h).right
      (fun empty => Decidable.byContradiction fun a => arange_bounds._proof_1_1 c live empty) fun bound => bound;
  have hh :=
    Nat.pow_le_pow_right (of_decide_eq_true (id (Eq.refl «true»)))
      (Nat.clog_mono_right 2 (Nat.div_le_self c.shape.width 2));
  ⟨Nat.pow_pos (of_decide_eq_true (id (Eq.refl «true»))),
    ⟨LE.le.trans hh hf, ⟨Nat.pow_pos (of_decide_eq_true (id (Eq.refl «true»))), hf⟩⟩⟩
