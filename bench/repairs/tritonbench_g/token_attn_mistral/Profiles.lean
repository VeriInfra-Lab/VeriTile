inductive Profile where
  | d1 | d2 | d4 | d8 | d16 | d32 | d64 | d128 | d16Unaligned | d16Strided | d64Strided
  deriving DecidableEq

def Profile.width : Profile → Nat
  | .d1 => 1 | .d2 => 2 | .d4 => 4 | .d8 => 8 | .d16 => 16 | .d32 => 32
  | .d64 => 64 | .d128 => 128 | .d16Unaligned => 16 | .d16Strided => 16 | .d64Strided => 64

def Profile.plan : Profile → Plan 128
  | .d1 => plan0 -- 1-aligned.ptx
  | .d2 => plan1 -- 2-aligned.ptx
  | .d4 => plan2 -- 4-aligned.ptx
  | .d8 => plan3 -- 8-aligned.ptx
  | .d16 => plan2 -- 16-aligned.ptx
  | .d32 => plan3 -- 32-aligned.ptx
  | .d64 => plan4 -- 64-aligned.ptx
  | .d128 => plan5 -- 128-aligned.ptx
  | .d16Unaligned => plan4 -- 16-unaligned.ptx
  | .d16Strided => plan2 -- 16-strided.ptx
  | .d64Strided => plan4 -- 64-strided.ptx

/-- Only the source's 128-token reduction reaches the selected plan.
The generic fallback is internal and is never used by this kernel. -/
def Profile.reductions (profile : Profile) : Reductions :=
  fun _ s ax _ _ _ =>
    if h : TileShape.axisDim s ax=128 then h.symm ▸ profile.plan
    else Plan.seeded (TileShape.axisDim s ax)

/-- All recorded adjacent product/add sites use the left-product FMA.
This is an instruction choice, not a floating reassociation equation. -/
def defaultFusion : Schedule := ⟨fun _ => .left⟩

theorem profile_leaf_coverage (profile : Profile) (i : Fin 128) :
    some i∈profile.plan.tree.leaves := profile.plan.lane_coverage i

#axiomsClean profile_leaf_coverage
#specNonCircular Profile.reductions avoiding [Grid.run,FP.Structural.exec]
end
end VeriTile.Bench.Repairs.TokenAttnMistral.Native
