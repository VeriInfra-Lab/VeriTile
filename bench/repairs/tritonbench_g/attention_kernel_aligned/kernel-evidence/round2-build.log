VeriTile.Bench.Repairs.AttentionKernelAligned.KernelContract.kernel_access (c : KernelOnly.Call)
  (hc : KernelOnly.InputContract c) (laws : KernelOnly.TensorLaws c) (x y block row dim key : ℕ)
  (hy : y < (KernelOnly.parameters c).batches * (KernelOnly.parameters c).heads)
  (hblock : block < (KernelOnly.parameters c).blocks) :
  (x * (KernelOnly.parameters c).blockM + row < (KernelOnly.parameters c).length ∧
        dim < (KernelOnly.parameters c).head →
      Whole.offset (Whole.qStrides (KernelOnly.parameters c)) (y / (KernelOnly.parameters c).heads)
          (y % (KernelOnly.parameters c).heads) (x * (KernelOnly.parameters c).blockM + row) dim <
        (KernelOnly.tensorStorage c hc laws).sizeQ) ∧
    (block * (KernelOnly.parameters c).blockN + key < (KernelOnly.parameters c).length ∧
          dim < (KernelOnly.parameters c).head →
        Whole.offset (Whole.kStrides (KernelOnly.parameters c)) (y / (KernelOnly.parameters c).heads)
            (y % (KernelOnly.parameters c).heads) (block * (KernelOnly.parameters c).blockN + key) dim <
          (KernelOnly.tensorStorage c hc laws).sizeK) ∧
      (block * (KernelOnly.parameters c).blockN + key < (KernelOnly.parameters c).length ∧
            dim < (KernelOnly.parameters c).head →
          Whole.offset (Whole.vStrides (KernelOnly.parameters c)) (y / (KernelOnly.parameters c).heads)
              (y % (KernelOnly.parameters c).heads) (block * (KernelOnly.parameters c).blockN + key) dim <
            (KernelOnly.tensorStorage c hc laws).sizeV) ∧
        (x * (KernelOnly.parameters c).blockM + row < (KernelOnly.parameters c).length →
            Whole.offset (Whole.bStrides (KernelOnly.parameters c)) (y / (KernelOnly.parameters c).heads)
                (y % (KernelOnly.parameters c).heads) (x * (KernelOnly.parameters c).blockM + row) block <
              (KernelOnly.tensorStorage c hc laws).sizeBias) ∧
          (x * (KernelOnly.parameters c).blockM + row < (KernelOnly.parameters c).length →
              Whole.offset (Whole.bStrides (KernelOnly.parameters c)) (y / (KernelOnly.parameters c).heads)
                  (y % (KernelOnly.parameters c).heads) (x * (KernelOnly.parameters c).blockM + row)
                  (key % (KernelOnly.parameters c).biasLast + (KernelOnly.parameters c).biasLast) <
                (KernelOnly.tensorStorage c hc laws).sizeBias) ∧
            (x * (KernelOnly.parameters c).blockM + row < (KernelOnly.parameters c).length ∧
                dim < (KernelOnly.parameters c).head →
              Whole.offset (Whole.oStrides (KernelOnly.parameters c)) (y / (KernelOnly.parameters c).heads)
                  (y % (KernelOnly.parameters c).heads) (x * (KernelOnly.parameters c).blockM + row) dim <
                (KernelOnly.tensorStorage c hc laws).sizeOut)
VeriTile.Bench.Repairs.AttentionKernelAligned.Correct.kernel_correct (c : KernelOnly.Call)
  (hc : KernelOnly.InputContract c) (laws : KernelOnly.TensorLaws c)
  (_dtype : (c.tensors Whole.Buffer.query).metadata.dtype = Torch.DType.other "float16") (read : ℕ → ℝ)
  (work : List Whole.Program) (order : (Whole.programs (Whole.grid (KernelOnly.parameters c))).Perm work) :
  ∃ after,
    Whole.runPrograms (fun x => Real.algebra) (fun x => Real.model) (KernelOnly.parameters c)
          (Whole.grid (KernelOnly.parameters c)) work (KernelOnly.realEntry c read) =
        some after ∧
      (∀ b < (KernelOnly.parameters c).batches,
          ∀ h < (KernelOnly.parameters c).heads,
            ∀ n < (KernelOnly.parameters c).length,
              ∀ d < (KernelOnly.parameters c).head,
                KernelOnly.logical (KernelOnly.observe KernelOnly.realDecode c read after) c Whole.Buffer.output b h n
                    d =
                  KernelOnly.mathematicalTarget c read b h n d) ∧
        KernelOnly.RawFrame c (KernelOnly.realEntry c read) after ∧
          (∀ (a : ℕ), ¬KernelOnly.Stored c a → KernelOnly.observe KernelOnly.realDecode c read after a = read a) ∧
            ∀ r ∈ KernelOnly.reads,
              ∀ (b h n d : ℕ),
                KernelOnly.Valid (KernelOnly.parameters c) r b h n d →
                  KernelOnly.logical (KernelOnly.observe KernelOnly.realDecode c read after) c r b h n d =
                    KernelOnly.logical read c r b h n d
VeriTile.Bench.Repairs.AttentionKernelAligned.BF16.Correct.kernel_correct (c : KernelOnly.Call)
  (hc : KernelOnly.InputContract c) (laws : KernelOnly.TensorLaws c)
  (_dtype : (c.tensors Whole.Buffer.query).metadata.dtype = Torch.DType.floating FP.Format.bf16) (read : ℕ → ℝ)
  (work : List BF16.Whole.Program)
  (order : (BF16.Whole.programs (BF16.Whole.grid (KernelOnly.parameters c))).Perm work) :
  ∃ after,
    BF16.Whole.runPrograms (fun x => BF16.Real.algebra) (fun x => BF16.Real.model) (KernelOnly.parameters c)
          (BF16.Whole.grid (KernelOnly.parameters c)) work (BF16.KernelOnly.realEntry c read) =
        some after ∧
      (∀ b < (KernelOnly.parameters c).batches,
          ∀ h < (KernelOnly.parameters c).heads,
            ∀ n < (KernelOnly.parameters c).length,
              ∀ d < (KernelOnly.parameters c).head,
                KernelOnly.logical (BF16.KernelOnly.observe BF16.KernelOnly.realDecode c read after) c
                    Whole.Buffer.output b h n d =
                  BF16.KernelOnly.mathematicalTarget c read b h n d) ∧
        BF16.KernelOnly.RawFrame c (BF16.KernelOnly.realEntry c read) after ∧
          (∀ (a : ℕ),
              ¬BF16.KernelOnly.Stored c a →
                BF16.KernelOnly.observe BF16.KernelOnly.realDecode c read after a = read a) ∧
            ∀ r ∈ KernelOnly.reads,
              ∀ (b h n d : ℕ),
                KernelOnly.Valid (KernelOnly.parameters c) r b h n d →
                  KernelOnly.logical (BF16.KernelOnly.observe BF16.KernelOnly.realDecode c read after) c r b h n d =
                    KernelOnly.logical read c r b h n d
VeriTile.Bench.Repairs.AttentionKernelAligned.FPEquiv.kernel_native (I : Native.Instructions) (c : KernelOnly.Call)
  (hc : KernelOnly.InputContract c) (laws : KernelOnly.TensorLaws c)
  (_dtype : (c.tensors Whole.Buffer.query).metadata.dtype = Torch.DType.other "float16")
  (_plan : KernelOnly.CompilerPlan c) (words : ℕ → BitVec 16) (work : List Whole.Program)
  (order : (Whole.programs (Whole.grid (KernelOnly.parameters c))).Perm work) :
  have before := KernelOnly.entry (KernelOnly.nativeReader c words);
  ∃ after,
    Whole.runPrograms (fun x => Native.algebraFor (KernelOnly.parameters c))
          (fun x => Native.modelFor (KernelOnly.parameters c)) (KernelOnly.parameters c)
          (Whole.grid (KernelOnly.parameters c)) work before =
        some after ∧
      (∀ b < (KernelOnly.parameters c).batches,
          ∀ h < (KernelOnly.parameters c).heads,
            ∀ n < (KernelOnly.parameters c).length,
              ∀ (d : ℕ) (hd : d < (KernelOnly.parameters c).head),
                KernelOnly.logical (KernelOnly.observe (KernelOnly.nativeDecode I d) c words after) c
                    Whole.Buffer.output b h n d =
                  KernelOnly.nativeReference I c words b h n d ⋯ hd) ∧
        KernelOnly.RawFrame c before after ∧
          (∀ (d a : ℕ),
              ¬KernelOnly.Stored c a → KernelOnly.observe (KernelOnly.nativeDecode I d) c words after a = words a) ∧
            ∀ (owner : ℕ),
              ∀ r ∈ KernelOnly.reads,
                ∀ (b h n d : ℕ),
                  KernelOnly.Valid (KernelOnly.parameters c) r b h n d →
                    KernelOnly.logical (KernelOnly.observe (KernelOnly.nativeDecode I owner) c words after) c r b h n
                        d =
                      KernelOnly.logical words c r b h n d
