VeriTile.Bench.Repairs.AttentionKernelAligned.Correct.empty_kernel {α β : Type} [Inhabited α]
  (M : FP.Structural.Algebra α) (P : FPValue.Primitives α) (c : KernelOnly.Call) (hc : KernelOnly.InputContract c)
  (empty : ¬Whole.Nonempty (KernelOnly.parameters c)) (before : State α) (work : List Whole.Program)
  (order : (Whole.programs (Whole.grid (KernelOnly.parameters c))).Perm work) (decode : α → β) (words : ℕ → β) :
