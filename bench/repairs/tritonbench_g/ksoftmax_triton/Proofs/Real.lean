import bench.repairs.tritonbench_g.ksoftmax_triton.Proofs.Math
import bench.tritonbench_g.ksoftmax_triton.Proofs.BackwardReal
import bench.tritonbench_g.ksoftmax_triton.Proofs.ForwardVariantIO

namespace VeriTile.Bench.Repairs.Ksoftmax
open VeriTile.Triton
open VeriTile.Bench.TritonBenchG.KsoftmaxTriton
set_option maxHeartbeats 5000000
set_option maxRecDepth 16000
set_option linter.unusedSimpArgs false

theorem backward_projects (Dst G O : RegionName)
    (bm bn gm gn om on K D : Nat) (log causal : Bool) :
    (backward Dst G O bm bn gm gn om on K D log causal).toAlgorithm? =
      .ok (backward Dst G O bm bn gm gn om on K D log causal).toAlgKernel := by
  cases log <;> cases causal <;> rfl

/-- Total execution of the repaired typed source after explicit dtype erasure.
The final state is generated by reducing the interpreter of the source itself. -/
noncomputable def backward_runState (Dst G O : RegionName)
    (bm bn gm gn om on K D : Nat) (log causal : Bool) (s : BlockState) :
    {t : BlockState // exec (backwardReal Dst G O bm bn gm gn om on K D log causal).toAlgKernel s = some t} := by
  cases log <;> cases causal
  all_goals
    refine ⟨?_, ?_⟩
    swap
    simp only [backwardReal,ComputeKernel.eraseDType,backward_projects,
      ComputeKernel.toAlgKernel_fromKernelBody]
    dsimp only [backwardReal,backward,ComputeKernel.surfaceBody,ComputeKernel.eraseDType,ComputeKernel.toAlgKernel,
      ComputeKernel.toAlgorithm?,ComputeStmt.listToAlgorithm?,ComputeStmt.toAlgorithm?,
      ComputeExpr.toAlgorithm?,ComputeOp.toAlgorithm?,Except.bind,Except.pure,Bind.bind,Pure.pure,
      ComputeKernel.toAlgKernel_fromKernelBody]
    simp [Kernel.eraseDType,Stmt.eraseDTypeList,Stmt.eraseDType,Op.eraseDType,
      MemAccess.eraseDType,MaskOpt.eraseDType,VeriTile.Triton.eraseDType,
      NumericDType.eraseDType,ComparableDType.eraseDType,FloatDType.toTileDType,Region.cast,ComputeDType.eraseDType,Op.eraseDType.eq_def,
      exec,stepStmts,stepStmt,evalOp.eq_def,tile_elementwise]
    try rfl

theorem backward_frame (Dst G O : RegionName)
    (bm bn gm gn om on K D : Nat) (log causal : Bool) (s t : BlockState)
    (ran : exec (backwardReal Dst G O bm bn gm gn om on K D log causal).toAlgKernel s=some t)
    (r : RegionName) (offset : Nat)
    (outside : ∀ i : Fin D, i.val<K → ¬(Dst=r ∧ s.pids 0*bm+s.pids 1*bn+i.val=offset)) :
    t.mem r offset=s.mem r offset := by
  have same:=Option.some.inj ((backward_runState Dst G O bm bn gm gn om on K D log causal s).property.symm.trans ran)
  subst t
  cases log <;> cases causal
  all_goals
    dsimp only [backward_runState]
    refine Eq.trans (foldl_store_preserve_cell _ _ _ r offset _ _ ?_) rfl
    intro j _ hm hc
    exact outside j.1 (by simpa using hm) hc

private theorem causal_padding {α : Type} (lane K row : Nat) (x z : α) :
    (if row<lane then z else if lane<K ∧ lane≤row then x else z)=
      (if lane<K ∧ lane≤row then x else z) := by
  by_cases h : lane≤row
  · simp [h,Nat.not_lt.mpr h]
  · simp [h,Nat.lt_of_not_ge h]

/-- The actual repaired real execution stores the independent causal derivative
on every written lane and preserves every unwritten region cell. -/
theorem backward_readback (Dst G O : RegionName)
    (bm bn gm gn om on K D : Nat) (log causal : Bool) (s t : BlockState)
    (ran : exec (backwardReal Dst G O bm bn gm gn om on K D log causal).toAlgKernel s=some t)
    (i : Fin D) :
    t.readMem Dst (s.pids 0*bm+s.pids 1*bn+i.val)=
      if i.val<K then gradient K (s.pids 1) log causal
        (fun j => s.readMem G (s.pids 0*gm+s.pids 1*gn+j.val))
        (fun j => s.readMem O (s.pids 0*om+s.pids 1*on+j.val)) i
      else s.readMem Dst (s.pids 0*bm+s.pids 1*bn+i.val) := by
  have same:=Option.some.inj ((backward_runState Dst G O bm bn gm gn om on K D log causal s).property.symm.trans ran)
  subst t
  cases log <;> cases causal
  all_goals
    dsimp only [backward_runState]
    rw [BlockState.scatter_readback_prop_masked_nd _ _ _ _
      (BlockState.tileIndex1d_base_offset_injective _) (i,PUnit.unit)]
    by_cases hi : i.val<K
    · have hz : (0.0 : ℝ)=0 := by norm_num
      by_cases hr : i.val≤s.pids 1
      · have hf := Nat.not_lt.mpr hr
        simp (config := { contextual := Bool.true })
          [hi,hz,hr,hf,gradient,Backward.readActive,tile_elementwise,causal_padding,
            MaskedReduction.ite_some_some,WithBot.sum_someTerm_eq_some]
        all_goals first | rfl | exact Or.inl rfl
      · have hf := Nat.lt_of_not_ge hr
        simp (config := { contextual := Bool.true })
          [hi,hz,hr,hf,gradient,Backward.readActive,tile_elementwise,causal_padding,
            MaskedReduction.ite_some_some,WithBot.sum_someTerm_eq_some]
        all_goals first | rfl | exact Or.inl rfl
    · simp [hi]

#axiomsClean backward_runState
#axiomsClean backward_frame
#axiomsClean backward_readback
end VeriTile.Bench.Repairs.Ksoftmax
