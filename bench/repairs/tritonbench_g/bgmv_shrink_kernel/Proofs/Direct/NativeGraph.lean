namespace VeriTile.Bench.Repairs.BgmvShrinkKernel.Direct.NativeGraph
open VeriTile Triton FP.Structural
noncomputable section
namespace NG
abbrev Term := VeriTile.Bench.Repairs.FastRmsLayernorm.NativeGraph.Term
abbrev Shape := VeriTile.Bench.Repairs.RmsnormFusedLlama.Native.Shape
abbrev shape := VeriTile.Bench.Repairs.FastRmsLayernorm.NativeGraph.shape
end NG

/-- Fixed-arity scalar arithmetic and a distinct storage-precision atomic
instruction. Atomic behavior is never replaced by ordinary FP addition. -/
structure Instructions where
  scalar : VeriTile.Bench.Repairs.FastRmsLayernorm.NativeGraph.Instructions
  atomicAdd : FloatDType → BitVec 32 → BitVec 32 → BitVec 32
inductive Expr where
  | word (value : BitVec 32)
  | literal (precision : Option ComputeDType) (dtype : FloatDType) (value : ℝ)
  | binary (precision : Option ComputeDType) (dtype : FloatDType) (op : Binary) (a b : Expr)
  | unary (precision : Option ComputeDType) (op : Unary) (a : Expr)
  | cast (precision : Option ComputeDType) (src dst : FloatDType) (a : Expr)
  | fromNat (precision : Option ComputeDType) (n : Nat)
  | fromInt (precision : Option ComputeDType) (n : Int)
  | atomic (dtype : FloatDType) (old operand : Expr)

def Expr.eval (I : Instructions) : Expr → BitVec 32
  | .word w => w
  | .literal p d x => I.scalar.literal p d x
  | .binary p d op a b => I.scalar.binary p d op (a.eval I) (b.eval I)
  | .unary p op a => I.scalar.unary p op (a.eval I)
  | .cast p src dst a => I.scalar.cast p src dst (a.eval I)
  | .fromNat p n => I.scalar.fromNat p n
  | .fromInt p n => I.scalar.fromInt p n
  | .atomic d a b => I.atomicAdd d (a.eval I) (b.eval I)

structure Selection where
  swap : NG.Shape → Bool

/-- Atomic tags are exclusive to `primitives.atomic`; every ordinary source
scalar uses the forward tag. Casts and each typed reduction join are retained.
The shrink source has no adjacent FP32 multiply/add contraction site. -/
def lower (S : Selection) : NG.Term → Expr
  | .leaf _ _ w => .word w
  | .literal p d x => .literal p d x
  | .negInf => .word 0xff800000
  | .binary .input none d .add a b => .atomic d (lower S a) (lower S b)
  | .binary _ p d op a b =>
    if S.swap (.binary p d op (NG.shape a) (NG.shape b)) && (op==.add || op==.mul || op==.max)
    then .binary p d op (lower S b) (lower S a) else .binary p d op (lower S a) (lower S b)
  | .unary _ p op a => .unary p op (lower S a)
  | .cast _ p src dst a => .cast p src dst (lower S a)
  | .fromNat p n => .fromNat p n
  | .fromInt p n => .fromInt p n
  | .bits w => .word w
  | .load a => lower S a
def eval (I : Instructions) (S : Selection) (term : NG.Term) := (lower S term).eval I

def algebra : Algebra NG.Term := VeriTile.Bench.Repairs.BgmvExpandSlice.Direct.Native.scalarAlgebra
def primitives (plans : ScalarTree.Plans) : FPValues.Primitives NG.Term where
  reduction := ScalarTree.reduction algebra plans
  atomic := fun d a b => .binary .input none d .add a b

theorem atomic_is_distinct (plans : ScalarTree.Plans) (S : Selection) (I : Instructions)
    (d : FloatDType) (old operand : NG.Term) :
    eval I S ((primitives plans).atomic d old operand)=I.atomicAdd d (eval I S old) (eval I S operand) := rfl

