structure CompilerBinding (plans : ScalarTree.Plans) (S : Selection) where
  sourceAST : String
  sourceIdentity : sourceAST=productionAST
  compilerPlans : ScalarTree.Plans
  planIdentity : compilerPlans=plans
  program : NG.Term → Expr
  lowered : ∀ term,program term=lower S term

theorem compiled_expression (binding : CompilerBinding plans S) (I : Instructions) (term : NG.Term) :
    (binding.program term).eval I=eval I S term := by rw [binding.lowered];rfl

