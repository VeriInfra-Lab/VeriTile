/-- Ordinary compilation binding: exact source identity and only local
conversion/add/m16n8k16 instruction agreements. No output or reduction oracle. -/
structure CompilerBinding (referenceOps : Native.Primitives) where
  sourceAST : String
  sourceIdentity : sourceAST=productionAST
  primitives : Native.Primitives
  agreement : Native.PrimitiveAgreement primitives referenceOps

theorem compiled (rest : Algebra Raw.Word) (ops : Native.Primitives)
    (binding : CompilerBinding ops) (zeros : NativeBackend.ZeroConversions ops)
    (t : Inputs) (s : Scalars) (a : Binding t) (before : Raw.State)
    (ok : Admitted t s (lists a before)) :
    execution rest binding.primitives t s a before=some (finalState rest binding.primitives t s a before) ∧
    (∀ cell,Touched (shape t s) (segments t s (lists a before)) cell → ∀ byte : Fin 4,
      sourceStores rest binding.primitives t s a before a.output.window.owner ((key a s cell).address+byte.val)=
        Raw.unpack (reference ops t s a before cell.1 cell.2) byte) ∧
    (∀ owner address,(∀ cell,Touched (shape t s) (segments t s (lists a before)) cell →
      ¬(key a s cell).covers owner address) →
        sourceStores rest binding.primitives t s a before owner address=before owner address) := by
  rw [Native.primitives_ext binding.primitives ops binding.agreement]
  exact whole rest ops zeros t s a before ok

#axiomsClean compiled
#auditModuleAxioms
end
end VeriTile.Bench.Repairs.SgmvExpandSlice.Direct.NativeCall
