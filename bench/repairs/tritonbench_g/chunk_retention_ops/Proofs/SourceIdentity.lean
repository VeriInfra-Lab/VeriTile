def productionSHA256 : String := "cd9a80f852cfa6502a4be8ab4be723d6f6d49caa34088dff0f5544f8aa9c7d90"

def typedBodies (c : Shape) (scale : ℝ) (seed rf terminal ri : Bool) :=
  [Source.forwardH "k" "v" "history" "seed" "final"
    c.keyHead c.K 1 c.valueHead c.V 1 c.historyHead c.V
    c.H c.T c.K c.V 64 c.BK c.BV c.chunks seed rf,
   Source.forwardO "q" "k" "v" "history" "output"
    c.keyHead c.K 1 c.valueHead c.V 1 c.historyHead c.V
    scale c.H c.T c.K c.V 64 c.BK c.BV,
   Source.backwardH "q" "incoming" "dhistory" "terminal" "initialGradient"
    c.keyHead c.K 1 c.valueHead c.V 1 c.historyHead c.V
    scale c.H c.T c.K c.V 64 c.BK c.BV c.chunks terminal ri,
   Source.backwardQKV "q" "k" "v" "history" "incoming" "dhistory" "dq" "dk" "dvPart"
    c.keyHead c.K 1 c.valueHead c.V 1 c.historyHead c.V
    scale c.H c.T c.K c.V 64 c.BK c.BV c.chunks,
   Source.forwardH "k" "v" "history" "seed" "final"
    c.keyHead c.K 1 c.valueHead c.V 1 c.historyHead c.V
    c.H c.T c.K c.V 64 c.BK c.BV c.chunks seed Bool.false]

/-- Ordinary compiler/runtime structural boundary. Typed source, source hash,
SSA-unfolded scalar/load/store instructions and the Tensor.sum reduction tree
are bound independently of input values. This cannot assert numerical output.
Shared scalar subexpressions may be represented once or unfolded as a tree. -/
structure Compiler (c : Shape) (tree : SumTree) (scale : ℝ) (seed rf terminal ri : Bool) where
  ast : String
  ast_eq : ast=productionAST
  sha256 : String
  sha256_eq : sha256=productionSHA256
  typed : List VeriTile.Triton.ComputeKernel
  typed_eq : typed=typedBodies c scale seed rf terminal ri
  forward : List Store
  forward_eq : forward=forwardCode c tree rf
  backward : List Store
  backward_eq : backward=backwardCode c tree ri
  sumCoverage : tree.Complete c.keyBlocks

end
end VeriTile.Bench.Repairs.ChunkRetentionOps.Whole001.Checked
