forward_grid_real : ∀ (shape : ParallelAttention.Shape),
  ParallelAttention.ShapeContract shape →
    ∀ (σ : ℝ) (s : Triton.FP.Structural.State ℝ),
      ∃ final,
        runPrograms (forwardLaunch realScalars shape σ) (programs shape 128) s = some final ∧
          SameInputs s final ∧
            (∀ (p : Program shape 128) (r : Fin 128) (v : Fin shape.BV),
                (outputRectangle shape p.tile 128).active (r, v, ()) →
                  final.mem { name := "o" } ((outputRectangle shape p.tile 128).address (r, v, ())) =
                    Triton.FP.Structural.Cell.mk Triton.TileDType.real
                      (ParallelAttention.outputSpec shape.T shape.K σ
                        (ParallelAttention.headInputs (inputReaders shape s) ↑p.head) (↑p.chunk * 128 + ↑r)
                        (↑p.value * shape.BV + ↑v))) ∧
              (∀ (p : Program shape 128) (r : Fin 128),
                  ↑p.value = 0 →
                    ↑p.chunk * 128 + ↑r < shape.T →
                      final.mem { name := "z" } (normalizerAddress shape p.tile ↑r) =
                        Triton.FP.Structural.Cell.mk Triton.TileDType.real
                          (ParallelAttention.normalizerSpec shape.T shape.K σ
                            (ParallelAttention.headInputs (inputReaders shape s) ↑p.head) (↑p.chunk * 128 + ↑r))) ∧
                ∀ (R : Triton.RegionName) (off : ℕ),
                  (∀ p ∈ programs shape 128, ¬forwardWrites shape p R off) → final.mem R off = s.mem R off
backward_grid_real : ∀ (shape : ParallelAttention.Shape),
  ParallelAttention.ShapeContract shape →
    ∀ (σ : ℝ) (s : Triton.FP.Structural.State ℝ),
      ∃ final,
        runPrograms (combinedLaunch realScalars shape σ) (programs shape 64) s = some final ∧
          SameInputs s final ∧
            (∀ p ∈ programs shape 64,
                ∀ (R : Triton.RegionName) (off : ℕ),
                  backwardWrites shape p R off →
                    final.mem R off = backwardMathTarget shape σ (inputReaders shape s) p R off) ∧
              ∀ (R : Triton.RegionName) (off : ℕ),
                (∀ p ∈ programs shape 64, ¬backwardWrites shape p R off) → final.mem R off = s.mem R off
CommonBacking.forward_joint : ∀ (actual reference : Scalars CommonBacking.Word),
  NativeStage.PrimitiveLaws actual reference →
    ∀ (d : ParallelAttention.NativePlans.Descriptor),
      ParallelAttention.ShapeContract d.shape →
        ∀ (σ : ℝ),
          TensorBinding.ScaleABI d σ →
            ∀ (read : CommonBacking.Memory) (inputs : TensorBinding.ForwardTensorInputs d.shape)
              (before : Triton.FP.Structural.State CommonBacking.Word)
              (backing : CommonBacking.ForwardBacking d.shape read inputs before),
              ∃ final post,
                runPrograms (fun p s => NativeStage.forwardRun actual d σ (withProgram p s)) (programs d.shape 128)
                      (TensorBinding.initialForward read inputs before) =
                    some final ∧
                  post =
                      CommonBacking.jointPost read backing.outputs.view (CommonBacking.forwardFootprint d.shape) final ∧
                    CommonBacking.JointBinding read post (TensorBinding.initialForward read inputs before) final
                        backing.outputs.view (CommonBacking.forwardInputs inputs)
                        (CommonBacking.forwardFootprint d.shape) ∧
                      (∀ (p : Program d.shape 128) (k : CommonBacking.ForwardPort) (i : ℕ),
                          forwardWrites d.shape p (backing.outputs.view k).region i →
                            (Torch.FP32.logicalValue post (backing.outputs.view k).tensor ⋯ i).bits =
                              Triton.FP.Structural.Cell.read Triton.TileDType.real
                                (NativeStage.forwardGridTarget reference d σ p
                                  (TensorBinding.initialForward read inputs before) (backing.outputs.view k).region
                                  i)) ∧
                        (∀ (R : Triton.RegionName) (i : ℕ),
                            ¬CommonBacking.forwardFootprint d.shape R i →
                              final.mem R i = (TensorBinding.initialForward read inputs before).mem R i) ∧
                          ∀ (p q : Program d.shape 128) (k l : CommonBacking.ForwardPort) (i j : ℕ),
                            forwardWrites d.shape p (backing.outputs.view k).region i →
                              forwardWrites d.shape q (backing.outputs.view l).region j →
                                CommonBacking.address (backing.outputs.view k) i =
                                    CommonBacking.address (backing.outputs.view l) j →
                                  p = q ∧ k = l ∧ i = j
CommonBacking.backward_joint : ∀ (actual reference : Scalars CommonBacking.Word),
  NativeStage.PrimitiveLaws actual reference →
    ∀ (d : ParallelAttention.NativePlans.Descriptor),
      ParallelAttention.ShapeContract d.shape →
        ∀ (σ : ℝ),
          TensorBinding.ScaleABI d σ →
            ∀ (read : CommonBacking.Memory) (inputs : TensorBinding.BackwardTensorInputs d.shape)
              (before : Triton.FP.Structural.State CommonBacking.Word)
              (backing : CommonBacking.BackwardBacking d.shape read inputs before),
              ∃ final post,
                runPrograms (NativeStage.combinedRun actual d σ) (programs d.shape 64)
                      (TensorBinding.initial read inputs before) =
                    some final ∧
                  post =
                      CommonBacking.jointPost read backing.outputs.view (CommonBacking.backwardFootprint d.shape)
                        final ∧
                    CommonBacking.JointBinding read post (TensorBinding.initial read inputs before) final
                        backing.outputs.view (CommonBacking.backwardInputs inputs)
                        (CommonBacking.backwardFootprint d.shape) ∧
                      (∀ (p : Program d.shape 64) (k : CommonBacking.BackwardPort) (i : ℕ),
                          backwardWrites d.shape p (backing.outputs.view k).region i →
                            (Torch.FP32.logicalValue post (backing.outputs.view k).tensor ⋯ i).bits =
                              Triton.FP.Structural.Cell.read Triton.TileDType.real
                                (NativeStage.backwardGridTarget reference d σ p
                                  (TensorBinding.initial read inputs before) (backing.outputs.view k).region i)) ∧
                        (∀ (R : Triton.RegionName) (i : ℕ),
                            ¬CommonBacking.backwardFootprint d.shape R i →
                              final.mem R i = (TensorBinding.initial read inputs before).mem R i) ∧
                          ∀ (p q : Program d.shape 64) (k l : CommonBacking.BackwardPort) (i j : ℕ),
                            backwardWrites d.shape p (backing.outputs.view k).region i →
                              backwardWrites d.shape q (backing.outputs.view l).region j →
                                CommonBacking.address (backing.outputs.view k) i =
                                    CommonBacking.address (backing.outputs.view l) j →
                                  p = q ∧ k = l ∧ i = j
