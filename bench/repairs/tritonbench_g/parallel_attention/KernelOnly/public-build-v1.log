forward_grid_real : ∀ (shape : ParallelAttention.Shape),
  ParallelAttention.ShapeContract shape →
    ∀ (σ : ℝ) (s : Triton.FP.Structural.State ℝ),
      ∃ final,
        runPrograms (forwardLaunch realScalars shape σ) (programs shape 128) s = some final ∧
          SameInputs s final ∧
            (∀ (p : Program shape 128) (r : Fin 128) (v : Fin shape.BV),
                (outputRectangle shape p.tile 128).active (r, v, ()) →
                  final.mem { name := "o" } ((outputRectangle shape p.tile 128).address (r, v, ())) =
                    Triton.FP.Structural.Cell.mk Triton.TileDType.real
                      (ParallelAttention.outputSpec shape.T shape.K σ
                        (ParallelAttention.headInputs (inputReaders shape s) ↑p.head) (↑p.chunk * 128 + ↑r)
                        (↑p.value * shape.BV + ↑v))) ∧
              (∀ (p : Program shape 128) (r : Fin 128),
                  ↑p.value = 0 →
                    ↑p.chunk * 128 + ↑r < shape.T →
                      final.mem { name := "z" } (normalizerAddress shape p.tile ↑r) =
                        Triton.FP.Structural.Cell.mk Triton.TileDType.real
                          (ParallelAttention.normalizerSpec shape.T shape.K σ
                            (ParallelAttention.headInputs (inputReaders shape s) ↑p.head) (↑p.chunk * 128 + ↑r))) ∧
                ∀ (R : Triton.RegionName) (off : ℕ),
                  (∀ p ∈ programs shape 128, ¬forwardWrites shape p R off) → final.mem R off = s.mem R off
backward_grid_real : ∀ (shape : ParallelAttention.Shape),
  ParallelAttention.ShapeContract shape →
    ∀ (σ : ℝ) (s : Triton.FP.Structural.State ℝ),
      ∃ final,
        runPrograms (combinedLaunch realScalars shape σ) (programs shape 64) s = some final ∧
          SameInputs s final ∧
            (∀ p ∈ programs shape 64,
                ∀ (R : Triton.RegionName) (off : ℕ),
                  backwardWrites shape p R off →
                    final.mem R off = backwardMathTarget shape σ (inputReaders shape s) p R off) ∧
              ∀ (R : Triton.RegionName) (off : ℕ),
                (∀ p ∈ programs shape 64, ¬backwardWrites shape p R off) → final.mem R off = s.mem R off
TensorBinding.forward_tensor : ∀ (actual reference : Scalars NativeStage.Word),
  NativeStage.PrimitiveLaws actual reference →
    ∀ (d : ParallelAttention.NativePlans.Descriptor),
      ParallelAttention.ShapeContract d.shape →
        ∀ (σ : ℝ),
          TensorBinding.ScaleABI d σ →
            ∀ (read : ℕ → Torch.FP32.Word) (inputs : TensorBinding.ForwardTensorInputs d.shape)
              (before : Triton.FP.Structural.State NativeStage.Word) (out : TensorBinding.View),
              out.region ∈ [{ name := "o" }, { name := "z" }] →
                out.tensor.metadata.shape = TensorBinding.forwardShape d.shape out.region →
                  (∀ i < out.tensor.metadata.numel,
                      Triton.FP.Structural.Cell.read Triton.TileDType.real
                          ((TensorBinding.initialForward read inputs before).mem out.region i) =
                        (read (out.base + 4 * i)).bits) →
                    ∃ final,
                      runPrograms (fun p s => NativeStage.forwardRun actual d σ (withProgram p s))
                            (programs d.shape 128) (TensorBinding.initialForward read inputs before) =
                          some final ∧
                        (∀ (p : Program d.shape 128),
                            ∀ i < out.tensor.metadata.numel,
                              forwardWrites d.shape p out.region i →
                                (Torch.FP32.logicalValue (TensorBinding.project read out final) out.tensor ⋯ i).bits =
                                  Triton.FP.Structural.Cell.read Triton.TileDType.real
                                    (NativeStage.forwardGridTarget reference d σ p
                                      (TensorBinding.initialForward read inputs before) out.region i)) ∧
                          (∀ (R : Triton.RegionName) (off : ℕ),
                              (∀ p ∈ programs d.shape 128, ¬forwardWrites d.shape p R off) →
                                final.mem R off = (TensorBinding.initialForward read inputs before).mem R off) ∧
                            ∀ (address : ℕ),
                              (¬∃ i < out.tensor.metadata.numel,
                                    (∃ p, forwardWrites d.shape p out.region i) ∧ address = out.base + 4 * i) →
                                TensorBinding.project read out final address = read address
TensorBinding.backward_tensor : ∀ (actual reference : Scalars NativeStage.Word),
  NativeStage.PrimitiveLaws actual reference →
    ∀ (d : ParallelAttention.NativePlans.Descriptor),
      ParallelAttention.ShapeContract d.shape →
        ∀ (σ : ℝ),
          TensorBinding.ScaleABI d σ →
            ∀ (read : ℕ → Torch.FP32.Word) (inputs : TensorBinding.BackwardTensorInputs d.shape)
              (before : Triton.FP.Structural.State NativeStage.Word) (out : TensorBinding.View),
              out.region ∈ [{ name := "dq" }, { name := "dk" }, { name := "dv" }] →
                out.tensor.metadata.shape = TensorBinding.backwardShape d.shape out.region →
                  (∀ i < out.tensor.metadata.numel,
                      Triton.FP.Structural.Cell.read Triton.TileDType.real
                          ((TensorBinding.initial read inputs before).mem out.region i) =
                        (read (out.base + 4 * i)).bits) →
                    ∃ final,
                      runPrograms (NativeStage.combinedRun actual d σ) (programs d.shape 64)
                            (TensorBinding.initial read inputs before) =
                          some final ∧
                        (∀ (p : Program d.shape 64),
                            ∀ i < out.tensor.metadata.numel,
                              backwardWrites d.shape p out.region i →
                                (Torch.FP32.logicalValue (TensorBinding.project read out final) out.tensor ⋯ i).bits =
                                  Triton.FP.Structural.Cell.read Triton.TileDType.real
                                    (NativeStage.backwardGridTarget reference d σ p
                                      (TensorBinding.initial read inputs before) out.region i)) ∧
                          (∀ (R : Triton.RegionName) (off : ℕ),
                              (∀ p ∈ programs d.shape 64, ¬backwardWrites d.shape p R off) →
                                final.mem R off = (TensorBinding.initial read inputs before).mem R off) ∧
                            ∀ (address : ℕ),
                              (¬∃ i < out.tensor.metadata.numel,
                                    (∃ p, backwardWrites d.shape p out.region i) ∧ address = out.base + 4 * i) →
                                TensorBinding.project read out final address = read address
