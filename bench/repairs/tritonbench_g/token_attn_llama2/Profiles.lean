inductive Profile where
  | d16Aligned | d16Unaligned | d32Aligned | d32Unaligned | d64Aligned | d64Unaligned | d128Aligned | d128Unaligned
  deriving DecidableEq

def Profile.dim : Profile → Nat
  | .d16Aligned => 16
  | .d16Unaligned => 16
  | .d32Aligned => 32
  | .d32Unaligned => 32
  | .d64Aligned => 64
  | .d64Unaligned => 64
  | .d128Aligned => 128
  | .d128Unaligned => 128
def Profile.contenders : Profile → Nat
  | .d16Aligned => 4
  | .d16Unaligned => 16
  | .d32Aligned => 8
  | .d32Unaligned => 32
  | .d64Aligned => 16
  | .d64Unaligned => 64
  | .d128Aligned => 32
  | .d128Unaligned => 64
def Profile.plan (p : Profile) (replica token : Nat) : Plan p.dim :=
  match p with
  | .d16Aligned => d16AlignedPlan replica token
  | .d16Unaligned => d16UnalignedPlan replica token
  | .d32Aligned => d32AlignedPlan replica token
  | .d32Unaligned => d32UnalignedPlan replica token
  | .d64Aligned => d64AlignedPlan replica token
  | .d64Unaligned => d64UnalignedPlan replica token
  | .d128Aligned => d128AlignedPlan replica token
  | .d128Unaligned => d128UnalignedPlan replica token

/-- Independent finite physical-writer choice for each CTA and logical output.
This selector contains no word-valued input or reduction-result callback. -/
abbrev Winner := Whole.Program → Nat → Fin 64

def Profile.reductions (profile : Profile) (winner : Nat → Fin 64) : Reductions :=
  fun _ s ax keep out _ =>
    let token := TileShape.linearIndex (TileShape.reduceShape s ax keep) out
    if h : TileShape.axisDim s ax=profile.dim then
      h.symm ▸ profile.plan (winner token).val token
    else Plan.seeded (TileShape.axisDim s ax)

/-- Every adjacent left product/add contracts. Final scale is physically the
first mul operand in the PTX; this does not invoke floating commutativity. -/
def defaultFusion : Schedule where
  fusion := fun _ => .left
  reverseScale := fun sh => match sh with
    | .binary _ _ .mul _ (.literal _ _ _) => Bool.true
    | _ => Bool.false

def Profile.hostScale (p : Profile) : ℝ :=
  if p.dim=16 then 1/4 else if p.dim=32 then 1592262918131443/9007199254740992
  else if p.dim=64 then 1/8 else 1592262918131443/18014398509481984

def Profile.scaleWord (p : Profile) : Word :=
  if p.dim=16 then 0x3e800000 else if p.dim=32 then 0x3e3504f3
  else if p.dim=64 then 0x3e000000 else 0x3db504f3

theorem profile_lane_coverage (p : Profile) (r n : Nat) (i : Fin p.dim) :
    some i∈(p.plan r n).tree.leaves := (p.plan r n).lane_coverage i

#axiomsClean profile_lane_coverage
#specNonCircular Profile.reductions avoiding [FP.Structural.exec,NativeGrid.runPrograms]
end
