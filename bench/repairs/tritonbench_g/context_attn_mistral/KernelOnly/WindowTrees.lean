def rename {n : Nat} (σ : Equiv.Perm (Fin n)) : Tree n → Tree n
  | .input i => .input (σ i)
  | .padding w => .padding w
  | .node a b => .node (rename σ a) (rename σ b)

theorem rename_indices {n : Nat} (σ : Equiv.Perm (Fin n)) (t : Tree n) :
    (rename σ t).indices=t.indices.map σ := by
  induction t with
  | input i => rfl
  | padding w => rfl
  | node a b ha hb => simp [rename,Tree.indices,ha,hb]

def renameOrdered {n : Nat} (σ : Equiv.Perm (Fin n)) (t : OrderedTree n) : OrderedTree n :=
  ⟨rename σ t.tree,by rw [rename_indices];exact (t.complete.map σ).trans σ.map_finRange_perm⟩

def rowLane (row : Nat) : Fin 128 := ⟨row%128,Nat.mod_lt _ (by decide)⟩

def maximum (width row owner : Nat) : OrderedTree 128 :=
  maxTree ((if width=128 then maxTable128 else maxTable16)[row%128*4+owner%4]?.getD 0)

def summation (width row owner : Nat) : OrderedTree 128 :=
  let selection := ((if width=128 then sumTable128 else sumTable16)[row%128*4+owner%4]?.getD (0,0))
  renameOrdered (Equiv.swap (rowLane selection.2) (rowLane row)) (sumTree selection.1)

def select (width window row owner n : Nat) (isMax : Bool) : OrderedTree n :=
  if h : n=128 then
    h ▸ (if window=1 then if isMax then maximum width row owner else summation width row owner
      else NativeD16.ordered owner)
  else NativeD16.treeFor n owner

#axiomsClean rename_indices
#guard_msgs (drop info) in
#auditModuleAxioms
end
