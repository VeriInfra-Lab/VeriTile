def VeriTile.Bench.Repairs.ContextAttnFwd.NativeSM90.plan : ℕ → ℕ → NativeGraph.Plan :=
fun bm d =>
  { matrixWidth := fun n => NativeSM90.widthFor (if bm = 64 ∧ 64 < d then n / 2 else n),
    reverseMul := fun x a b x_1 => NativeSM90.reverseMul a b, reverseFMA := fun x x_1 x_2 x_3 => «false»,
    sumTree := fun {x} x_1 x_2 x_3 owner => NativeSM90.treeFor (x.axisDim x_1) owner,
    maxTree := fun {x} x_1 x_2 x_3 owner => NativeSM90.treeFor (x.axisDim x_1) owner, route := NativeSM90.route bm d }
def VeriTile.Bench.Repairs.ContextAttnFwd.KernelScale.Bound : Host.Call → Prop :=
fun c => Host.scale c = KernelScale.value c.args.q.dims
